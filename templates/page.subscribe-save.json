    "90c898db-a1b6-4cdf-a928-29ab51f67a7e": {
      "type": "faq",
      "blocks": {
        "template--16968027930882__90c898db-a1b6-4cdf-a928-29ab51f67a7e-question-1": {
          "type": "question",
          "settings": {
            "question": "HOW DO I SIGN UP FOR SUBSCRIBE & SAVE?",
            "answer": "<p>It’s simple! Just select the \"Subscribe & Save\" option on the product page, choose your preferred delivery frequency, and add the item to your cart. Complete checkout as usual, and you’ll start receiving automatic shipments based on your selected schedule.</p>"
          }
        },
        "template--16968027930882__90c898db-a1b6-4cdf-a928-29ab51f67a7e-question-2": {
          "type": "question",
          "settings": {
            "question": "CAN I CHANGE OR CANCEL MY SUBSCRIPTION",
            "answer": "<p>Absolutely. You can update your subscription frequency, skip a delivery, or cancel your subscription anytime through your account. There are no long-term commitments or hidden fees.</p>"
          }
        },
        "template--16968027930882__90c898db-a1b6-4cdf-a928-29ab51f67a7e-question-3": {
          "type": "question",
          "settings": {
            "question": "CAN I USE DISCOUNT CODES OR PROMOTIONS ON SUBSCRIBE & SAVE?",
            "answer": "<p>Discount codes or one-time promotions cannot be applied to subscription orders, as you’re already receiving exclusive savings through the Subscribe & Save program.</p>"
          }
        },
        "question_rfETXC": {
          "type": "question",
          "settings": {
            "question": "HOW DO I MANAGE MY SUBSCRIPTIONS?",
            "answer": "<p>Simply log into your account and navigate to the \"Subscriptions\" section. From there, you can modify delivery schedules, skip shipments, update payment information, or cancel your subscription.</p>"
          }
        }
      },
