        "rev_1": {
          "type": "review",
          "settings": {
            "quote": "<p>\"I have taken NanoGreens for years after my naturopathic doctor suggested it. I feel so much better when I use it consistently — more energy, better digestion. It's become a non-negotiable part of my morning.\"</p>",
            "author": "Jennifer M.",
            "date": "Verified Buyer"
          }
        },
        "rev_2": {
          "type": "review",
          "settings": {
            "quote": "<p>\"Excellent way to support your digestive tract. I highly recommend this for athletes and seniors alike. The enzyme blend is something you just don't find in most greens powders.\"</p>",
            "author": "David R.",
            "date": "Verified Buyer"
          }
        },
        "rev_3": {
          "type": "review",
          "settings": {
            "quote": "<p>\"I've been taking NanoGreens for years. I mix it every afternoon when I start getting hungry and it satisfies me and keeps me going. I order on a subscription — that's the only way to do it.\"</p>",
            "author": "Karen T.",
            "date": "Verified Buyer"
          }
        },
        "review_EeLytV": {
          "type": "review",
          "settings": {
            "quote": "<p>\"The green apple flavor actually tastes good — that alone sets it apart. I've tried four or five other greens powders and always quit them. This one I look forward to every morning.\"</p>",
            "author": "Ashley W.",
            "date": "Verified Buyer"
          }
        },
        "review_3Jw8a6": {
          "type": "review",
          "settings": {
            "quote": "<p>\"I bought this for my husband after his doctor recommended a greens supplement. He's been on it for six months and won't go without it now. We both take it. Worth every penny.\"</p>",
            "author": "Linda H.",
            "date": "Verified Buyer"
          }
        },
        "review_DUfQAA": {
          "type": "review",
          "settings": {
            "quote": "<p>\"I was skeptical at first — I've wasted money on supplements before. But NanoGreens actually delivers. My gut feels better, my energy is steadier, and I don't get that mid-afternoon crash anymore. Reordered three times.\"</p>",
            "author": "Marcus B.",
            "date": "Verified Buyer"
          }
        }
