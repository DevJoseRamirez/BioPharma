    "cwc_faq": {
      "type": "CWC_faq",
      "blocks": {
        "faq_take": {
          "type": "faq",
          "settings": {
            "question": "How do I take it?",
            "answer": "<p>One 12g scoop in 8–16 oz of cold water. Shake, stir, or blend. Best first thing in the morning. Also mixes well into smoothies, unsweetened almond milk, or coconut milk. For children under 12, use half a scoop. 30 servings per container.</p>",
            "open": false
          }
        },
        "faq_gluten": {
          "type": "faq",
          "settings": {
            "question": "Is NanoGreens gluten free?",
            "answer": "<p>NanoGreens is our only product containing trace gluten, from organic barley grass. We are FDA gluten-free compliant, but not certified gluten-free — depending on the batch, trace amounts range from 7–12 parts per million.</p>",
            "open": false
          }
        },
        "faq_organic": {
          "type": "faq",
          "settings": {
            "question": "Does it contain allergens?",
            "answer": "<p>NanoGreens contains soy (lecithin and soy phospholipids) and trace gluten from organic barley grass. It contains no dairy, nuts or eggs.</p>",
            "open": false
          }
        },
        "faq_sweet": {
          "type": "faq",
          "settings": {
            "question": "Is NanoGreens organic?",
            "answer": "<p>Everything that can be sourced organically is. A few key ingredients can't be sourced organically at this time, so we use non-GMO, all-natural ingredients with no artificial ingredients or pesticides.</p>",
            "open": false
          }
        },
        "faq_fridge": {
          "type": "faq",
          "settings": {
            "question": "What makes it sweet?",
            "answer": "<p>Stevia leaf extract — no artificial sweeteners, and under 1g of added sugar per serving. Prefer it less sweet? Add more water, or a squeeze of lemon or lime.</p>",
            "open": false
          }
        },
        "faq_scoop": {
          "type": "faq",
          "settings": {
            "question": "Does it need to be refrigerated?",
            "answer": "<p>Not required. We suggest the fridge after opening mostly as a daily reminder to take it.</p>",
            "open": false
          }
        },
        "faq_pros": {
          "type": "faq",
          "settings": {
            "question": "How do you get this much into one scoop?",
            "answer": "<p>We buy organic greens, fruits and vegetables grown specifically for their high phytonutrient content, then juice them and low-temperature freeze-dry — which concentrates freshly juiced produce without the sugar, fiber and water.</p>",
            "open": false
          }
        },
        "faq_subscription": {
          "type": "faq",
          "settings": {
            "question": "Is it used by healthcare professionals?",
            "answer": "<p>Yes. NanoGreens was distributed through doctors, chiropractors and naturopaths for years before being sold direct, and is still carried by clinicians today.</p>",
            "open": false
          }
        },
        "faq_MfGMbL": {
          "type": "faq",
          "settings": {
            "question": "How does the subscription work?",
            "answer": "<p>Choose a 90-day or 30-day supply. It renews automatically at the same price with free shipping. Pause, reschedule or cancel anytime.</p>",
            "open": false
          }
        }
      },
