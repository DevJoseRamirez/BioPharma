        "feature_b2": {
          "type": "feature",
          "settings": {
            "column": "left",
            "icon": "shopify://shop_images/benefit-icon-digestion-settles_2.png",
            "title": "Digestion That Settles Down",
            "text": "<p>Nine digestive enzymes and fiber support regularity and post-meal comfort, so it works with your gut instead of sitting in it.</p>"
          }
        },
        "feature_b3": {
          "type": "feature",
          "settings": {
            "column": "left",
            "icon": "shopify://shop_images/benefit-icon-steady-energy_2.png",
            "title": "Energy Without The Crash",
            "text": "<p>Zero caffeine and no stimulants — steady support through the afternoon with nothing to come down from at 3pm.</p>"
          }
        },
        "feature_b4": {
          "type": "feature",
          "settings": {
            "column": "right",
            "icon": "shopify://shop_images/benefit-icon-absorption_2.png",
            "title": "Absorption, Not Just Ingredients",
            "text": "<p>Supersorb® emulsification suspends fat-soluble nutrients so they can cross into you, which is the part almost every greens powder skips.</p>"
          }
        },
