{% style %}
  #cwc_bundle-upgrade-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#F4F3EE' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --card-highlight-bg: {{ section.settings.card_highlight_bg_color | default: '#FAFDF6' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --deep-color: {{ section.settings.deep_color | default: '#44681A' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#5BA90F' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 60 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_bundle_upgrade.css' | asset_url | stylesheet_tag }}

<section id="cwc_bundle-upgrade-{{ section.id }}" class="cwc_bundle-upgrade">
  <div class="cwc_bundle-upgrade__container">
    <div class="cwc_bundle-upgrade__inner">

      {% comment %} Section Header {% endcomment %}
      <div class="cwc_bundle-upgrade__content">
        {% if section.settings.eyebrow != blank %}
          <div class="cwc_bundle-upgrade__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_bundle-upgrade__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_bundle-upgrade__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}
      </div>

      {% comment %} Stack comparison {% endcomment %}
      {% if section.blocks.size > 0 %}
        <div class="cwc_bundle-upgrade__stack">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'column' %}
                <div
                  class="cwc_bundle-upgrade__column{% if block.settings.highlighted %} cwc_bundle-upgrade__column--highlighted{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.ribbon_text != blank %}
                    <span class="cwc_bundle-upgrade__ribbon">{{ block.settings.ribbon_text }}</span>
                  {% endif %}

                  {% if block.settings.tag != blank %}
                    <div class="cwc_bundle-upgrade__tag">{{ block.settings.tag }}</div>
                  {% endif %}

                  <div class="cwc_bundle-upgrade__products">
                    {% if block.settings.image != blank %}
                      <img
                        src="{{ block.settings.image | image_url: width: 400 }}"
                        alt="{{ block.settings.name | escape }}"
                        width="200"
                        height="224"
                        loading="lazy"
                      >
                    {% else %}
                      <span class="cwc_bundle-upgrade__product-placeholder">Add image</span>
                    {% endif %}

                    {% if block.settings.ghost_labels != blank %}
                      {% assign ghosts = block.settings.ghost_labels | split: ',' %}
                      {% for ghost in ghosts limit: 4 %}
                        <span class="cwc_bundle-upgrade__ghost"><span>{{ ghost | strip }}</span></span>
                      {% endfor %}
                    {% endif %}
                  </div>

                  {% if block.settings.name != blank %}
                    <div class="cwc_bundle-upgrade__name">{{ block.settings.name }}</div>
                  {% endif %}

                  <div class="cwc_bundle-upgrade__price">
                    {% if block.settings.price != blank %}
                      <span class="cwc_bundle-upgrade__price-now">{{ block.settings.price }}</span>
                    {% endif %}
                    {% if block.settings.compare_price != blank %}
                      <span class="cwc_bundle-upgrade__price-was">{{ block.settings.compare_price }}</span>
                    {% endif %}
                  </div>

                  {% if block.settings.per_text != blank %}
                    <div class="cwc_bundle-upgrade__per">{{ block.settings.per_text }}</div>
                  {% endif %}

                  {% if block.settings.features_included != blank %}
                    <div class="cwc_bundle-upgrade__features cwc-rte">
                      {{ block.settings.features_included }}
                    </div>
                  {% endif %}

                  {% if block.settings.features_excluded != blank %}
                    <div class="cwc_bundle-upgrade__features cwc_bundle-upgrade__features--excluded cwc-rte">
                      {{ block.settings.features_excluded }}
                    </div>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}

          {% if section.settings.cost_left_label != blank or section.settings.cost_right_label != blank %}
            <div class="cwc_bundle-upgrade__costs">
              <div class="cwc_bundle-upgrade__cost">
                {{ section.settings.cost_left_label }}
                <b>{{ section.settings.cost_left_value }}</b>
              </div>
              <div class="cwc_bundle-upgrade__cost">
                {{ section.settings.cost_right_label }}
                <b>{{ section.settings.cost_right_value }}</b>
              </div>
            </div>
          {% endif %}

          <div class="cwc_bundle-upgrade__actions">
            {% if section.settings.cta_text != blank %}
              <a href="{{ section.settings.cta_link | default: '#' }}" class="cwc_bundle-upgrade__button">
                {{ section.settings.cta_text }}
              </a>
            {% endif %}

            {% if section.settings.decline_text != blank %}
              <a href="{{ section.settings.decline_link | default: '#' }}" class="cwc_bundle-upgrade__decline">
                {{ section.settings.decline_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="cwc_bundle-upgrade__empty">
          <p>Add columns to display the bundle comparison.</p>
        </div>
      {% endif %}

      {% if section.settings.note != blank %}
        <div class="cwc_bundle-upgrade__note">{{ section.settings.note }}</div>
      {% endif %}

    </div>
  </div>
</section>

