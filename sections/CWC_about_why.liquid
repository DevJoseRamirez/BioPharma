{% style %}
  #cwc_about-why-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --heading-color: {{ section.settings.heading_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#44681A' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#44681A' }};
    --body-color: {{ section.settings.body_color | default: '#514D3D' }};
    --measure: {{ section.settings.max_width | default: 760 }}px;
    --text-align: {{ section.settings.text_align | default: 'left' }};
    --padding-top: {{ section.settings.padding_top | default: 100 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 100 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 100 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_about_why.css' | asset_url | stylesheet_tag }}

<section id="cwc_about-why-{{ section.id }}" class="cwc_about-why">
  <div class="cwc_about-why__container">
    <div class="cwc_about-why__content">

      {% if section.settings.eyebrow != blank %}
        <div class="cwc_about-why__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_about-why__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="cwc_about-why__content-subtext cwc-rte">
          {{ section.settings.body }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC About Why We Exist",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why we exist"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Most supplements are built to a price. Ours isn't.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Copy",
      "default": "<p>There's a version of every formula that costs less to make. Swap the juiced greens for cheaper grass powder. Drop the enzyme blend nobody can see on a label. Use a proprietary blend so the doses stay private. It happens constantly, and it usually happens quietly.</p><p>We've made the same decision the other way for twenty years. When an ingredient gets more expensive, we pay for it rather than reformulate around it. That's the whole company, more or less — one stubborn position, applied to every product we've released since.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content Width",
      "min": 480,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#514D3D"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "About Why We Exist",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
