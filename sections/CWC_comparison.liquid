{% style %}
  #cwc_comparison-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#44681A' }};
    --section-bg-end: {{ section.settings.bg_end_color | default: '#31501A' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#A3C781' }};
    --brand-card-bg: {{ section.settings.brand_card_bg_color | default: '#4C7024' }};
    --brand-card-text: {{ section.settings.brand_card_text_color | default: '#ffffff' }};
    --competitor-card-bg: {{ section.settings.competitor_card_bg_color | default: '#ffffff' }};
    --competitor-card-text: {{ section.settings.competitor_card_text_color | default: '#2A2611' }};
    --divider-color: {{ section.settings.divider_color | default: '#78AD49' }};
    --cross-color: {{ section.settings.cross_color | default: '#2A2611' }};
    --check-color: {{ section.settings.check_color | default: '#A3C781' }};
    --media-height: {{ section.settings.media_height | default: 150 }}px;
    --media-height-mobile: {{ section.settings.media_height | default: 150 | times: 0.6 }}px;
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_comparison.css' | asset_url | stylesheet_tag }}

{%- capture cwc_comparison_icon_cross -%}
  <svg class="cwc_comparison__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="11" fill="currentColor"></circle>
    <path d="M8.6 8.6 15.4 15.4M15.4 8.6 8.6 15.4" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
  </svg>
{%- endcapture -%}

<section id="cwc_comparison-{{ section.id }}" class="cwc_comparison">
  <div class="cwc_comparison__container">
    {% comment %} Section Header — rendered above the grid, shown on mobile only {% endcomment %}
    {% if section.settings.heading != blank or section.settings.subtext != blank %}
      <div class="cwc_comparison__content cwc_comparison__content--mobile">
        {% if section.settings.heading != blank %}
          <div class="cwc_comparison__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_comparison__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="cwc_comparison__wrapper">
      {% comment %} Left — comparison tables {% endcomment %}
      <div class="cwc_comparison__tables">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'brand_table' %}
              <div class="cwc_comparison__column" {{ block.shopify_attributes }}>
                <div class="cwc_comparison__column-media">
                  {% if block.settings.product_image != blank %}
                    <img
                      src="{{ block.settings.product_image | image_url: width: 120 }}"
                      alt="{{ block.settings.title | default: 'Product' | escape }}"
                      loading="lazy"
                      width="400"
                      height="{{ 400 | divided_by: block.settings.product_image.aspect_ratio | round }}"
                    >
                  {% endif %}
                </div>

                <div class="cwc_comparison__card cwc_comparison__card--brand">
                  {% if block.settings.title != blank %}
                    <div class="cwc_comparison__card-title cwc_comparison__card-title--brand">
                      {{ block.settings.title }}
                    </div>
                  {% endif %}

                  <ul class="cwc_comparison__list">
                    {% for i in (1..5) %}
                      {% assign icon_key = 'icon' | append: i %}
                      {% assign text_key = 'text' | append: i %}
                      {% assign row_icon = block.settings[icon_key] %}
                      {% assign row_text = block.settings[text_key] %}

                      {% if row_text != blank %}
                        <li class="cwc_comparison__item">
                          {% if row_icon != blank %}
                            <span class="cwc_comparison__item-icon">
                              <img
                                src="{{ row_icon | image_url: width: 64 }}"
                                alt=""
                                loading="lazy"
                                width="32"
                                height="32"
                              >
                            </span>
                          {% endif %}
                          <span class="cwc_comparison__item-text">{{ row_text }}</span>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>
              </div>

            {% when 'competitor_table' %}
              <div class="cwc_comparison__column" {{ block.shopify_attributes }}>
                <div class="cwc_comparison__column-media">
                  {% if block.settings.product_image != blank %}
                    <img
                      src="{{ block.settings.product_image | image_url: width: 120 }}"
                      alt="{{ block.settings.title | default: 'Other brands' | escape }}"
                      loading="lazy"
                      width="400"
                      height="{{ 400 | divided_by: block.settings.product_image.aspect_ratio | round }}"
                    >
                  {% endif %}
                </div>

                <div class="cwc_comparison__card cwc_comparison__card--competitor">
                  {% if block.settings.title != blank %}
                    <div class="cwc_comparison__card-title">
                      {{ block.settings.title }}
                    </div>
                  {% endif %}

                  <ul class="cwc_comparison__list">
                    {% for i in (1..5) %}
                      {% assign text_key = 'text' | append: i %}
                      {% assign row_text = block.settings[text_key] %}

                      {% if row_text != blank %}
                        <li class="cwc_comparison__item">
                          <span class="cwc_comparison__item-icon cwc_comparison__item-icon--cross">
                            {{ cwc_comparison_icon_cross }}
                          </span>
                          <span class="cwc_comparison__item-text">{{ row_text }}</span>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      {% comment %} Right — heading, bullets, CTA {% endcomment %}
      <div class="cwc_comparison__panel">
        {% if section.settings.heading != blank or section.settings.subtext != blank %}
          <div class="cwc_comparison__content cwc_comparison__content--desktop">
            {% if section.settings.heading != blank %}
              <div class="cwc_comparison__content-heading cwc-rte">
                {{ section.settings.heading }}
              </div>
            {% endif %}

            {% if section.settings.subtext != blank %}
              <div class="cwc_comparison__content-subtext cwc-rte">
                {{ section.settings.subtext }}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% assign bullet_blocks = section.blocks | where: 'type', 'bullet' %}
        {% if bullet_blocks.size > 0 %}
          <ul class="cwc_comparison__bullets">
            {% for block in section.blocks %}
              {% if block.type == 'bullet' and block.settings.text != blank %}
                <li class="cwc_comparison__bullet" {{ block.shopify_attributes }}>
                  <span class="cwc_comparison__bullet-icon">
                    <svg class="cwc_comparison__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <circle cx="12" cy="12" r="11" fill="currentColor"></circle>
                      <path d="m7.4 12.4 3.1 3.1 6.1-6.6" fill="none" stroke="#44681A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span class="cwc_comparison__bullet-text cwc-rte">{{ block.settings.text }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% for block in section.blocks %}
          {% if block.type == 'button' and block.settings.button_text != blank %}
            <div class="cwc_comparison__button" {{ block.shopify_attributes }}>
              <a
                href="{{ block.settings.button_link | default: '#' }}"
                class="cwc_comparison__button-link"
                style="--button-bg: {{ block.settings.button_bg_color }}; --button-text: {{ block.settings.button_text_color }};"
              >
                {{ block.settings.button_text }}
              </a>

              {% if block.settings.button_note != blank or block.settings.show_note_icon %}
                <div class="cwc_comparison__button-note" style="--note-color: {{ block.settings.note_color }};">
                  {% if block.settings.show_note_icon %}
                    <svg class="cwc_comparison__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 2.5 20 5.4v5.9c0 4.9-3.3 8.8-8 10.7-4.7-1.9-8-5.8-8-10.7V5.4l8-2.9Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                    </svg>
                  {% endif %}
                  {% if block.settings.button_note != blank %}
                    <span>{{ block.settings.button_note }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Comparison",
  "settings": [
    { "type": "header", "content": "Section Header" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Resilia® vs. <strong>Other Brands</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext"
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (Top)",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "bg_end_color",
      "label": "Background Color (Bottom)",
      "default": "#31501A",
      "info": "The section background is a vertical gradient between these two colors. Set both the same for a flat background."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#A3C781"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Bullet Check Color",
      "default": "#A3C781"
    },

    { "type": "header", "content": "Card Colors" },
    {
      "type": "color",
      "id": "brand_card_bg_color",
      "label": "Brand Card Background",
      "default": "#4C7024"
    },
    {
      "type": "color",
      "id": "brand_card_text_color",
      "label": "Brand Card Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "competitor_card_bg_color",
      "label": "Competitor Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "competitor_card_text_color",
      "label": "Competitor Card Text Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Row Divider Color",
      "default": "#78AD49"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Competitor Cross Icon Color",
      "default": "#2A2611"
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "media_height",
      "label": "Product Image Height",
      "min": 0,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 150,
      "info": "Reserved height for the product images sitting above the cards. Both cards use the same height so their tops stay aligned. Set to 0 to hide."
    },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "brand_table",
      "name": "Brand Table",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image",
          "info": "Sits above the card, overlapping its top edge."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Table Title",
          "default": "RESILIA"
        },
        { "type": "header", "content": "Row 1" },
        { "type": "image_picker", "id": "icon1", "label": "Row 1 Icon" },
        { "type": "text", "id": "text1", "label": "Row 1 Text", "default": "Clinically-Studied Ingredients" },
        { "type": "header", "content": "Row 2" },
        { "type": "image_picker", "id": "icon2", "label": "Row 2 Icon" },
        { "type": "text", "id": "text2", "label": "Row 2 Text", "default": "3rd-Party Tested" },
        { "type": "header", "content": "Row 3" },
        { "type": "image_picker", "id": "icon3", "label": "Row 3 Icon" },
        { "type": "text", "id": "text3", "label": "Row 3 Text", "default": "Allergen-Free & Clean" },
        { "type": "header", "content": "Row 4" },
        { "type": "image_picker", "id": "icon4", "label": "Row 4 Icon" },
        { "type": "text", "id": "text4", "label": "Row 4 Text", "default": "Global Certified Facilities" },
        { "type": "header", "content": "Row 5" },
        { "type": "image_picker", "id": "icon5", "label": "Row 5 Icon" },
        { "type": "text", "id": "text5", "label": "Row 5 Text", "default": "Vegan & Gluten-Free" }
      ]
    },
    {
      "type": "competitor_table",
      "name": "Competitor Table",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image",
          "info": "Sits above the card, overlapping its top edge."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Table Title",
          "default": "Other Brands"
        },
        { "type": "text", "id": "text1", "label": "Row 1 Text", "default": "Trend-Based Blends" },
        { "type": "text", "id": "text2", "label": "Row 2 Text", "default": "No Test Proof" },
        { "type": "text", "id": "text3", "label": "Row 3 Text", "default": "Fillers & Additives" },
        { "type": "text", "id": "text4", "label": "Row 4 Text", "default": "Low-Quality Manufacturing" },
        { "type": "text", "id": "text5", "label": "Row 5 Text", "default": "Sugar, Flavors, Binders" }
      ]
    },
    {
      "type": "bullet",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Bullet Text",
          "default": "<p><strong>Clinically-Studied Ingredients</strong> — Ingredients with real research behind them</p>",
          "info": "Bold the lead-in phrase; the rest reads as regular text."
        }
      ]
    },
    {
      "type": "button",
      "name": "CTA Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Try Risk-Free Today" },
        { "type": "url", "id": "button_link", "label": "Button Link" },
        { "type": "color", "id": "button_bg_color", "label": "Button Background", "default": "#5BA90F" },
        { "type": "color", "id": "button_text_color", "label": "Button Text Color", "default": "#ffffff" },
        { "type": "checkbox", "id": "show_note_icon", "label": "Show Shield Icon", "default": true },
        { "type": "text", "id": "button_note", "label": "Note Text" },
        { "type": "color", "id": "note_color", "label": "Note Color", "default": "#A3C781" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Comparison",
      "category": "CWC Custom",
      "blocks": [
        { "type": "brand_table" },
        { "type": "competitor_table" },
        {
          "type": "bullet",
          "settings": {
            "text": "<p><strong>Clinically-Studied Ingredients</strong> — Ingredients with real research behind them, including 82 clinical trials on black seed oil</p>"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "<p><strong>Steady Daily Support</strong> — Built for long-term use, not 7-day cleanses</p>"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "<p><strong>Clean & Pure</strong> — No fillers, GMOs, sugar, or artificial additives</p>"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "<p><strong>Visible, Gradual Results</strong> — A daily ritual that keeps working, week after week</p>"
          }
        },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
