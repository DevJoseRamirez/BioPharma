{% style %}
  #cwc_home-reviews-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --panel-bg: {{ section.settings.panel_bg_color | default: '#FAF9F4' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --star-color: {{ section.settings.star_color | default: '#E8A317' }};
    --bar-bg: {{ section.settings.bar_bg_color | default: '#E6E5DC' }};
    --bar-fill: {{ section.settings.bar_fill_color | default: '#78AD49' }};
    --padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 50 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 50 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_home_reviews.css' | asset_url | stylesheet_tag }}

<section id="cwc_home-reviews-{{ section.id }}" class="cwc_home-reviews">
  <div class="cwc_home-reviews__container">

    {% comment %} Split Head Row {% endcomment %}
    <div class="cwc_home-reviews__head">
      <div class="cwc_home-reviews__content">
        {% if section.settings.eyebrow != blank %}
          <div class="cwc_home-reviews__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_home-reviews__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.view_all_label != blank %}
        <a class="cwc_home-reviews__view-all" href="{{ section.settings.view_all_link | default: '#' }}">
          {{ section.settings.view_all_label }}
        </a>
      {% endif %}
    </div>

    <div class="cwc_home-reviews__wrapper">

      {% comment %} Aggregate Panel {% endcomment %}
      <div class="cwc_home-reviews__panel">
        {% assign rating_rounded = section.settings.rating_value | round %}
        <div class="cwc_home-reviews__panel-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            {%- if i <= rating_rounded -%}★{%- else -%}☆{%- endif -%}
          {%- endfor -%}
        </div>

        <div class="cwc_home-reviews__panel-value">{{ section.settings.rating_value }}</div>

        {% if section.settings.rating_count != blank %}
          <div class="cwc_home-reviews__panel-count">{{ section.settings.rating_count }}</div>
        {% endif %}

        {% if section.settings.show_distribution %}
          {% capture bar_values %}{{ section.settings.pct_5 }},{{ section.settings.pct_4 }},{{ section.settings.pct_3 }},{{ section.settings.pct_2 }},{{ section.settings.pct_1 }}{% endcapture %}
          {% assign bar_list = bar_values | split: ',' %}
          {% assign star_labels = '5,4,3,2,1' | split: ',' %}

          <div class="cwc_home-reviews__bars">
            {% for pct in bar_list %}
              <div class="cwc_home-reviews__bar">
                <span class="cwc_home-reviews__bar-label">{{ star_labels[forloop.index0] }}★</span>
                <span class="cwc_home-reviews__bar-track">
                  <span class="cwc_home-reviews__bar-fill" style="width: {{ pct }}%;"></span>
                </span>
                <span class="cwc_home-reviews__bar-value">{{ pct }}%</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% comment %} Review Cards {% endcomment %}
      {%- comment -%}
        Every review is rendered into the page. The ones past the fourth carry
        `hidden`, so they are in the markup — which is what a reviews block is
        for — without being tabbed into or read out until Load More reveals
        them.

        review_count is counted rather than read off section.blocks.size so
        that a block type added to this section later cannot be mistaken for a
        review and put a button under a grid that has nothing more to show.
      {%- endcomment -%}
      {%- liquid
        assign initial_count = 4
        assign reveal_batch = 4

        assign review_count = 0
        for block in section.blocks
          if block.type == 'review'
            assign review_count = review_count | plus: 1
          endif
        endfor
      -%}

      {% if section.blocks.size > 0 %}
        <div class="cwc_home-reviews__grid">
          {%- assign review_index = 0 -%}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'review' %}
                {%- assign review_index = review_index | plus: 1 -%}
                <div
                  class="cwc_home-reviews__card"
                  data-cwc-reviews-card
                  {% if review_index > initial_count %}hidden{% endif %}
                  {{ block.shopify_attributes }}
                >
                  {% assign block_rating = block.settings.rating | round %}
                  <div class="cwc_home-reviews__card-stars" aria-hidden="true">
                    {%- for i in (1..5) -%}
                      {%- if i <= block_rating -%}★{%- else -%}☆{%- endif -%}
                    {%- endfor -%}
                  </div>

                  {% if block.settings.quote != blank %}
                    <p class="cwc_home-reviews__card-text">{{ block.settings.quote }}</p>
                  {% endif %}

                  {% if block.settings.author_name != blank or block.settings.verified_label != blank %}
                    <div class="cwc_home-reviews__card-title">
                      {%- if block.settings.author_name != blank -%}
                        {{ block.settings.author_name }}
                      {%- endif -%}
                      {%- if block.settings.verified_label != blank -%}
                        {{ ' ' }}<span>· {{ block.settings.verified_label }}</span>
                      {%- endif -%}
                    </div>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}

          {%- comment -%}
            Only rendered when there is genuinely something behind it. A button
            that reveals nothing is worse than no button, so the test is on the
            review count rather than on the section having blocks at all.

            It lives inside the grid, spanning both card columns, so it sits
            under the cards instead of becoming a third column of the outer
            two-column wrapper.
          {%- endcomment -%}
          {% if review_count > initial_count %}
            <div class="cwc_home-reviews__more">
              <button
                type="button"
                class="cwc_home-reviews__more-button"
                data-cwc-reviews-more
                data-cwc-reveal-batch="{{ reveal_batch }}"
              >
                {{ section.settings.load_more_label | default: 'Load more reviews' }}
              </button>
            </div>
          {% endif %}
        </div>
      {% else %}
        <div class="cwc_home-reviews__empty">
          <p>Add review blocks to display content.</p>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{{ 'CWC_home_reviews.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "CWC Home Reviews",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "614 verified buyers"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>The routines people <strong>have kept.</strong></p>"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "Read all reviews →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load More Label",
      "info": "Button under the cards. Only appears once there are more than 4 reviews.",
      "default": "Load more reviews"
    },
    {
      "type": "header",
      "content": "Aggregate Panel"
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Rating Value",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Review Count Text",
      "default": "614 verified reviews"
    },
    {
      "type": "checkbox",
      "id": "show_distribution",
      "label": "Show Distribution Bars",
      "info": "Replace these with live values if a reviews app owns this data.",
      "default": true
    },
    {
      "type": "range",
      "id": "pct_5",
      "label": "5 Star Percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 84
    },
    {
      "type": "range",
      "id": "pct_4",
      "label": "4 Star Percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "range",
      "id": "pct_3",
      "label": "3 Star Percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 3
    },
    {
      "type": "range",
      "id": "pct_2",
      "label": "2 Star Percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 2
    },
    {
