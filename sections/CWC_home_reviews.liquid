      "id": "star_color",
      "label": "Star Color",
      "default": "#E8A317"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Aggregate Panel Background",
      "default": "#FAF9F4"
