{% style %}
  #cwc_home-subscribe-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#F2F8EA' }};
    --section-bg-end: {{ section.settings.bg_color_end | default: '#FAF9F4' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --accent-color: {{ section.settings.accent_color | default: '#5BA90F' }};
    --tier-active-bg: {{ section.settings.tier_active_bg_color | default: '#F2F8EA' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#5BA90F' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 50 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 50 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_home_subscribe.css' | asset_url | stylesheet_tag }}

{% liquid
  assign benefit_count = 0
  assign tier_count = 0
  for block in section.blocks
    if block.type == 'benefit'
      assign benefit_count = benefit_count | plus: 1
    endif
    if block.type == 'tier'
      assign tier_count = tier_count | plus: 1
    endif
  endfor
%}

<section
  id="cwc_home-subscribe-{{ section.id }}"
  class="cwc_home-subscribe{% if section.settings.tiers_interactive %} cwc_home-subscribe--interactive{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="cwc_home-subscribe__container">
    <div class="cwc_home-subscribe__wrapper">

      {% comment %} Left: copy + benefits + CTA {% endcomment %}
      <div class="cwc_home-subscribe__content">
        {% if section.settings.eyebrow != blank %}
          <div class="cwc_home-subscribe__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_home-subscribe__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if benefit_count > 0 %}
          <ul class="cwc_home-subscribe__list">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'benefit' %}
                  {% if block.settings.text != blank %}
                    <li class="cwc_home-subscribe__list-item" {{ block.shopify_attributes }}>
                      <span class="cwc_home-subscribe__tick" aria-hidden="true">✓</span>
                      <span>{{ block.settings.text }}</span>
                    </li>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <a
            class="cwc_home-subscribe__button"
            href="{{ section.settings.cta_link | default: '#' }}"
            data-cwc-cta
          >
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
      </div>

      {% comment %} Right: tier card {% endcomment %}
      {% if tier_count > 0 %}
        <div class="cwc_home-subscribe__card">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'tier' %}
                <div
                  class="cwc_home-subscribe__tier{% if block.settings.is_active %} cwc_home-subscribe__tier--active{% endif %}"
                  {% if section.settings.tiers_interactive %}
                    role="button"
                    tabindex="0"
                    data-cwc-tier
                    data-cwc-tier-link="{{ block.settings.cta_link | default: '' }}"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  <div class="cwc_home-subscribe__tier-info">
                    {% if block.settings.label != blank %}
                      <b class="cwc_home-subscribe__tier-title">{{ block.settings.label }}</b>
                    {% endif %}

                    {% if block.settings.sub_label != blank %}
                      <span class="cwc_home-subscribe__tier-text">{{ block.settings.sub_label }}</span>
                    {% endif %}
                  </div>

                  <div class="cwc_home-subscribe__tier-amount">
                    {% if block.settings.amount != blank %}
                      <b>{{ block.settings.amount }}</b>
                    {% endif %}

                    {% if block.settings.amount_suffix != blank %}
                      <span>{{ block.settings.amount_suffix }}</span>
                    {% endif %}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{{ 'CWC_home_subscribe.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "CWC Home Subscribe",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Subscribe & save"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>The easiest way to <strong>keep the routine stocked.</strong></p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Choose a subscription"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Tiers"
    },
    {
      "type": "checkbox",
      "id": "tiers_interactive",
      "label": "Make Tiers Selectable",
      "info": "Off: tiers are a display-only price table. On: clicking a tier selects it and repoints the button at that tier's link.",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (Top)",
      "default": "#F2F8EA"
    },
    {
      "type": "color",
      "id": "bg_color_end",
      "label": "Background Color (Bottom)",
      "default": "#FAF9F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted Text Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#5BA90F"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Tier Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E6E5DC"
    },
    {
      "type": "color",
      "id": "tier_active_bg_color",
      "label": "Active Tier Background",
      "default": "#F2F8EA"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit Text",
          "default": "Save up to 25% versus one-time purchase"
        }
      ]
    },
    {
      "type": "tier",
      "name": "Price Tier",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tier Label",
          "default": "90-day supply"
        },
        {
          "type": "text",
          "id": "sub_label",
          "label": "Tier Sub-label",
          "default": "$1.87 per serving · best value"
        },
        {
          "type": "text",
          "id": "amount",
          "label": "Amount",
          "default": "$56.21"
        },
        {
          "type": "text",
          "id": "amount_suffix",
          "label": "Amount Suffix",
          "default": "/mo"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Mark As Active",
          "default": false
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Tier Link",
          "info": "Only used when tiers are selectable."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Home Subscribe",
      "category": "CWC Custom",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "tier" },
        { "type": "tier" },
        { "type": "tier" }
      ]
    }
  ]
}
{% endschema %}
