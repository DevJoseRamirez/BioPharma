{% style %}
    #cwc_header-{{ section.id }} {
      --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
      --text-color: {{ section.settings.text_color | default: '#5C5842' }};
      --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
      --logo-color: {{ section.settings.logo_color | default: '#2A2611' }};
      --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
      --dropdown-bg: {{ section.settings.dropdown_bg_color | default: '#ffffff' }};
      --search-bg: {{ section.settings.search_bg_color | default: '#ffffff' }};
      --search-field-bg: {{ section.settings.search_field_bg_color | default: '#F4F3EE' }};
      --search-accent: {{ section.settings.search_accent_color | default: '#44681A' }};
      --search-muted: {{ section.settings.search_muted_color | default: '#5C5842' }};
      --search-chip-bg: {{ section.settings.search_chip_bg_color | default: '#F2F8EA' }};
      --search-chip-border: {{ section.settings.search_chip_border_color | default: '#A3C781' }};
      --search-overlay-color: {{ section.settings.search_overlay_color | default: '#2A2611' }};
      --search-overlay-opacity: {{ section.settings.search_overlay_opacity | default: 45 | divided_by: 100.0 }};
      --search-panel-height: {{ section.settings.search_panel_height | default: 60 }}vh;
      --logo-height: {{ section.settings.logo_height | default: 34 }}px;
      --logo-height-mobile: {{ section.settings.logo_height_mobile | default: 28 }}px;
      --logo-text-size: {{ section.settings.logo_text_size | default: 22 }}px;
      --logo-text-size-mobile: {{ section.settings.logo_text_size_mobile | default: 20 }}px;
      --padding-top: {{ section.settings.padding_top | default: 15 }}px;
      --padding-bottom: {{ section.settings.padding_bottom | default: 15 }}px;
      --padding-top-mobile: {{ section.settings.padding_top | default: 15 | times: 0.5 }}px;
      --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 15 | times: 0.5 }}px;
    }

  .announcement-bar-section,
  footer,
    sticky-header {
      display: none !important;
    }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_header.css' | asset_url | stylesheet_tag }}

{% comment %}
  Audience split. 'wholesale' is the tag the rest of the theme keys off
  (sections/header.liquid, sections/main-product.liquid, snippets/product-card.liquid);
  everyone else — including logged-out visitors — is retail.

  Each audience picks its own bar layout, so the wholesale storefront reads as
  visually distinct from the retail one:
    retail    — menu left, wordmark centred on the bar (the standard header)
    wholesale — wordmark left, menu centred between wordmark and icons
{% endcomment %}
{% liquid
  assign nav_menu = section.settings.menu
  assign is_wholesale_customer = false

  for tag in customer.tags
    assign customer_tag = tag | strip | downcase
    if customer_tag == 'wholesale'
      assign is_wholesale_customer = true
      break
    endif
  endfor

  if is_wholesale_customer
    assign header_layout = section.settings.layout_wholesale | default: 'logo_left'
    if section.settings.menu_wholesale != blank
      assign nav_menu = section.settings.menu_wholesale
    endif
  else
    assign header_layout = section.settings.layout_retail | default: 'logo_center'
  endif
%}

<section
  id="cwc_header-{{ section.id }}"
  class="cwc_header{% if section.settings.enable_sticky %} cwc_header--sticky{% endif %}{% if header_layout == 'logo_left' %} cwc_header--logo-left{% endif %}"
>
  <div class="cwc_header__bar">
    <div class="cwc_header__container">
      {% comment %} Menu toggle — mobile only, sits left of the wordmark {% endcomment %}
      <div class="cwc_header__toggle-wrap">
        <button
          type="button"
          class="cwc_header__toggle"
          aria-label="Menu"
          aria-expanded="false"
          data-cwc-toggle
        >
          <span></span><span></span><span></span>
        </button>
      </div>

      {% comment %}
        Primary links — Shopify menu first, manual blocks as fallback.
        nav_menu is resolved above, alongside the audience layout.
      {% endcomment %}
      {% if nav_menu != blank and nav_menu.links.size > 0 %}
        <nav class="cwc_header__links" data-cwc-menu>
          {% for link in nav_menu.links %}
            {% if link.links.size > 0 %}
              <div class="cwc_header__item cwc_header__item--has-dropdown">
                <a
                  href="{{ link.url }}"
                  class="cwc_header__link{% if link.active or link.child_active %} cwc_header__link--active{% endif %}"
                >
                  {{ link.title }}
                  <svg class="cwc_header__caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </a>

                <div class="cwc_header__dropdown">
                  {% for child_link in link.links %}
                    <a
                      href="{{ child_link.url }}"
                      class="cwc_header__dropdown-link{% if child_link.active %} cwc_header__dropdown-link--active{% endif %}"
                    >
                      {{ child_link.title }}
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% else %}
              <div class="cwc_header__item">
                <a
                  href="{{ link.url }}"
                  class="cwc_header__link{% if link.active %} cwc_header__link--active{% endif %}"
                >
                  {{ link.title }}
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </nav>
      {% elsif section.blocks.size > 0 %}
        <nav class="cwc_header__links" data-cwc-menu>
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'link' %}
                {% if block.settings.label != blank %}
                  <div class="cwc_header__item" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.link | default: '#' }}" class="cwc_header__link">
                      {{ block.settings.label }}
                    </a>
                  </div>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </nav>
      {% endif %}

      {% comment %} Wordmark {% endcomment %}
      <a href="{{ routes.root_url }}" class="cwc_header__logo">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ section.settings.logo_alt | default: shop.name | escape }}"
            class="cwc_header__logo-image"
            width="200"
            height="40"
            loading="eager"
          >
        {% else %}
          <span class="cwc_header__logo-text">
            {%- if section.settings.logo_text_lead != blank -%}
              <span class="cwc_header__logo-lead">{{ section.settings.logo_text_lead }}</span>
            {%- endif -%}
            {%- if section.settings.logo_text_accent != blank -%}
              <span class="cwc_header__logo-accent">{{ section.settings.logo_text_accent }}</span>
            {%- endif -%}
          </span>
        {% endif %}
      </a>

      {% comment %} Utility links {% endcomment %}
      <div class="cwc_header__utility">
        {% if section.settings.show_account %}
          <a href="{{ routes.account_url }}" class="cwc_header__icon" aria-label="Account">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.6"></circle>
              <path d="M4.6 20c0-4 3.3-6.2 7.4-6.2s7.4 2.2 7.4 6.2"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_search %}
          {%- comment -%}
            Stays a real link to the search page, so it still works if the script
            never runs. The handler cancels the navigation and opens the panel.
          {%- endcomment -%}
          <a
            href="{{ routes.search_url }}"
            class="cwc_header__icon"
            aria-label="Search"
            aria-haspopup="dialog"
            aria-expanded="false"
            data-cwc-search-open
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="6.4"></circle>
              <path d="M15.8 15.8 20 20"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_cart %}
          <a href="{{ routes.cart_url }}" class="cwc_header__icon" aria-label="Cart">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 7h14l-1.2 12.2H6.2z"></path>
              <path d="M9 7V5.6A3 3 0 0 1 15 5.6V7"></path>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.settings.show_search %}
    {% render 'CWC_header-search__panel', section: section %}
  {% endif %}
</section>

{{ 'CWC_header.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "CWC Header",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Bar Layout"
    },
    {
      "type": "paragraph",
      "content": "Retail and wholesale each get their own bar arrangement, so the two storefronts read as visually distinct. Customers tagged 'wholesale' see the wholesale layout; everyone else, including logged-out visitors, sees the retail one. Below 992px both share the same mobile drawer."
    },
    {
      "type": "select",
      "id": "layout_retail",
      "label": "Retail Layout",
      "info": "Standard visitors. Leave as-is to keep today's header.",
      "options": [
        { "value": "logo_center", "label": "Logo centered, menu left" },
        { "value": "logo_left", "label": "Logo left, menu centered" }
      ],
      "default": "logo_center"
    },
    {
      "type": "select",
      "id": "layout_wholesale",
      "label": "Wholesale Layout",
      "info": "Only seen by logged-in customers tagged 'wholesale'. The theme editor always previews the retail layout, so switch Retail Layout temporarily to check this one.",
      "options": [
        { "value": "logo_left", "label": "Logo left, menu centered" },
        { "value": "logo_center", "label": "Logo centered, menu left" }
      ],
      "default": "logo_left"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Select a menu from Online Store > Navigation. Dropdowns render for any item with sub-links. Leave empty to use the manual Nav Link blocks below instead."
    },
    {
      "type": "header",
      "content": "Navigation (Wholesale Customers)"
    },
    {
      "type": "link_list",
      "id": "menu_wholesale",
      "label": "Menu (Wholesale Customers)",
      "info": "Shown instead of the menu above to logged-in customers tagged 'wholesale'. Leave empty and wholesale customers see the standard menu."
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image",
      "info": "Optional. Overrides the text wordmark below."
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo Alt Text",
      "default": "NanoGreens"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Image Height — Desktop",
      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo Image Height — Mobile",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "text",
      "id": "logo_text_lead",
      "label": "Wordmark — Leading Word",
      "default": "nano"
    },
    {
      "type": "text",
      "id": "logo_text_accent",
      "label": "Wordmark — Accent Word",
      "default": "greens"
    },
    {
      "type": "range",
      "id": "logo_text_size",
      "label": "Wordmark Text Size — Desktop",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22,
      "info": "Applies when no Logo Image is set."
    },
    {
      "type": "range",
      "id": "logo_text_size_mobile",
      "label": "Wordmark Text Size — Mobile",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Utility Links"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Search Panel"
    },
    {
      "type": "paragraph",
      "content": "The search icon opens a panel under the header with live product results. Which products match is controlled by the Search & Discovery app."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder Text",
      "default": "Search products"
    },
    {
      "type": "text",
      "id": "search_popular_label",
      "label": "Popular Searches Heading",
      "default": "Popular searches"
    },
    {
      "type": "text",
      "id": "search_popular",
      "label": "Popular Searches",
      "info": "Comma separated. Shown as tappable chips before the shopper types.",
      "default": "greens, collagen, bundles, weight loss"
    },
    {
      "type": "range",
      "id": "search_limit",
      "label": "Results Shown",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "search_min_chars",
      "label": "Characters Before Searching",
      "info": "Lower values search sooner but fire more requests.",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "search_panel_height",
      "label": "Panel Height",
      "info": "Share of the screen height the panel may fill on desktop. Full screen on mobile regardless.",
      "min": 25,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Search Panel Colors"
    },
    {
      "type": "color",
      "id": "search_bg_color",
      "label": "Panel Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "search_field_bg_color",
      "label": "Search Field Background Color",
      "default": "#F4F3EE"
    },
    {
      "type": "color",
      "id": "search_accent_color",
      "label": "Accent Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "search_muted_color",
      "label": "Muted Text Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "search_chip_bg_color",
      "label": "Popular Chip Background Color",
      "default": "#F2F8EA"
    },
    {
      "type": "color",
      "id": "search_chip_border_color",
      "label": "Popular Chip Border Color",
      "default": "#A3C781"
    },
    {
      "type": "color",
      "id": "search_overlay_color",
      "label": "Backdrop Color",
      "default": "#2A2611"
    },
    {
      "type": "range",
      "id": "search_overlay_opacity",
      "label": "Backdrop Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Stick Header To Top On Scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Nav Link Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Wordmark Accent Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Wordmark Base Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E6E5DC"
    },
    {
      "type": "color",
      "id": "dropdown_bg_color",
      "label": "Dropdown Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Header",
      "category": "CWC Custom",
      "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }]
    }
  ]
}
{% endschema %}
