    {
      "type": "header",
      "content": "Search Panel Colors"
    },
    {
      "type": "color",
      "id": "search_bg_color",
      "label": "Panel Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "search_field_bg_color",
      "label": "Search Field Background Color",
      "default": "#F4F3EE"
    },
    {
      "type": "color",
      "id": "search_accent_color",
      "label": "Accent Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "search_muted_color",
      "label": "Muted Text Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "search_chip_bg_color",
      "label": "Popular Chip Background Color",
      "default": "#F2F8EA"
    },
    {
      "type": "color",
      "id": "search_chip_border_color",
      "label": "Popular Chip Border Color",
      "default": "#A3C781"
    },
    {
      "type": "color",
      "id": "search_overlay_color",
      "label": "Backdrop Color",
      "default": "#2A2611"
    },
    {
      "type": "range",
      "id": "search_overlay_opacity",
      "label": "Backdrop Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Stick Header To Top On Scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Nav Link Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Wordmark Accent Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Wordmark Base Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E6E5DC"
    },
    {
      "type": "color",
      "id": "dropdown_bg_color",
      "label": "Dropdown Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Mega Menu & Drawer Colors"
    },
    {
      "type": "color",
      "id": "mega_bg_color",
      "label": "Panel Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mega_muted_color",
      "label": "Muted Text",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "mega_panel_bg_color",
      "label": "Tile Background",
      "default": "#F5F4F0"
    },
    {
      "type": "color",
      "id": "mega_promo_bg_color",
      "label": "Promo Card Background",
      "default": "#ECEBE5"
    },
    {
      "type": "color",
      "id": "mega_button_bg_color",
      "label": "Promo Button Background",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "mega_button_text_color",
      "label": "Promo Button Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "drawer_bg_color",
      "label": "Drawer Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "drawer_cart_bg_color",
      "label": "Drawer Cart Button",
      "default": "#1F1F1C"
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Scrim",
      "default": "#1F1F1C"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "mega_panel",
      "name": "Mega Menu Panel",
      "limit": 4,
      "settings": [
        {
          "type": "paragraph",
          "content": "Adding this block is what turns a menu item into a mega menu. A menu item with children but no block stays an ordinary dropdown; a menu item with no children at all can still open a panel made only of the cards below. Link columns come from your Shopify menu — a top-level item's children become column headings and their children become the links."
        },
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu Item",
          "default": "Shop",
          "info": "Required. The exact title of the top-level menu item this panel belongs to, e.g. Shop or Learn. Case does not matter. Leave it blank or misspell it and the item falls back to a plain dropdown."
        },
        {
