{% comment %}
  Audience split. 'wholesale' is the tag the rest of the theme keys off
  (sections/header.liquid, sections/main-product.liquid, snippets/product-card.liquid);
  everyone else — including logged-out visitors — is retail.

  The two audiences differ by MENU, not by bar arrangement. An earlier version
  gave each its own layout; both now share the one bar — wordmark left, nav
  centred, utilities right — because two arrangements meant two sets of
  breakpoint rules for a distinction the menu already carries.
{% endcomment %}
{% liquid
  assign nav_menu = section.settings.menu
  assign is_wholesale_customer = false

  for tag in customer.tags
    assign customer_tag = tag | strip | downcase
    if customer_tag == 'wholesale'
      assign is_wholesale_customer = true
      break
    endif
  endfor

  if is_wholesale_customer and section.settings.menu_wholesale != blank
    assign nav_menu = section.settings.menu_wholesale
  endif

  assign show_counts = section.settings.show_menu_counts

  comment
    The promo the drawer borrows: the first mega panel that has one. Picked here
    rather than inside the drawer so the drawer does not have to know how blocks
    are matched to menu items.
  endcomment
  assign drawer_promo_block = blank
  for header_block in section.blocks
    if header_block.type == 'mega_panel'
      if header_block.settings.promo_heading != blank or header_block.settings.promo_text != blank
        assign drawer_promo_block = header_block
        break
      endif
    endif
  endfor
%}

<section
  id="cwc_header-{{ section.id }}"
  class="cwc_header{% if section.settings.enable_sticky %} cwc_header--sticky{% endif %}"
  data-cwc-header
  data-cwc-breakpoint="{{ section.settings.mobile_breakpoint | default: 1000 }}"
>
  <div class="cwc_header__bar">
    <div class="cwc_header__container">
      {%- comment -%}
        Burger first in the source and far left on screen, on the side the
        drawer arrives from. Hidden above the breakpoint.
      {%- endcomment -%}
      <div class="cwc_header__toggle-wrap">
        <button
          type="button"
          class="cwc_header__toggle"
          aria-label="Open menu"
          aria-expanded="false"
          data-cwc-toggle
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
      </div>

      {% comment %} Wordmark {% endcomment %}
      <a href="{{ routes.root_url }}" class="cwc_header__logo">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ section.settings.logo_alt | default: shop.name | escape }}"
            class="cwc_header__logo-image"
            width="200"
            height="40"
            loading="eager"
          >
        {% else %}
          <span class="cwc_header__logo-text">
            {%- if section.settings.logo_text_lead != blank -%}
              <span class="cwc_header__logo-lead">{{ section.settings.logo_text_lead }}</span>
            {%- endif -%}
            {%- if section.settings.logo_text_accent != blank -%}
              <span class="cwc_header__logo-accent">{{ section.settings.logo_text_accent }}</span>
            {%- endif -%}
          </span>
        {% endif %}
      </a>

      {%- comment -%}
        Primary navigation — Shopify menu first, manual Nav Link blocks as the
        fallback for a shop that has not built a menu yet.

        A Mega Menu Panel block is what makes an item a mega, not the depth of
        its menu. The panel holds content a Shopify menu cannot — product tiles,
        a promo card — so the item that owns one has to be declared rather than
        inferred, and an item nobody declared is free to stay an ordinary
        dropdown. It also means a link with no children at all can still open a
        panel made purely of cards.

        Three shapes fall out of that, in order of precedence:
          block            → mega panel (menu columns, if any, plus cards)
          children, no block → plain dropdown
          neither          → plain link

        The mega spans the whole bar rather than hanging off the item, so a mega
        item is position:static and its panel anchors to the bar. A dropdown item
        is the opposite — it is positioned, so its small panel hangs off the link
        it belongs to.
      {%- endcomment -%}
      {% if nav_menu != blank and nav_menu.links.size > 0 %}
        <nav class="cwc_header__nav" data-cwc-nav>
          {% for link in nav_menu.links %}
            {%- liquid
              comment
                The block that claims this item, matched on the item's title.
                Matching on the title rather than on position means reordering
                the menu cannot move a panel onto the wrong item.
              endcomment
              assign panel_block = blank
              assign wanted_title = link.title | strip | downcase

              for header_block in section.blocks
                if header_block.type == 'mega_panel'
                  assign block_title = header_block.settings.menu_item | strip | downcase
                  if block_title != blank and block_title == wanted_title
                    assign panel_block = header_block
                    break
                  endif
                endif
              endfor

              assign is_mega = false
              if panel_block != blank
                assign is_mega = true
              endif

              assign is_dropdown = false
              if is_mega == false and link.links.size > 0
                assign is_dropdown = true
              endif
            -%}

            {% if is_mega %}
              <div
                class="cwc_header__item cwc_header__item--has-mega"
                data-cwc-nav-item
                {{ panel_block.shopify_attributes }}
              >
                <a
                  href="{{ link.url }}"
                  class="cwc_header__link{% if link.active or link.child_active %} cwc_header__link--active{% endif %}"
                  aria-expanded="false"
                  data-cwc-nav-trigger
                >
                  {{ link.title }}
                  <svg class="cwc_header__caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </a>

                {% render 'CWC_header-mega__panel',
                  link: link,
                  block: panel_block,
                  show_counts: show_counts
                %}
              </div>
            {% elsif is_dropdown %}
              {%- comment -%}
                No block claimed this item, so its children render as an ordinary
                dropdown hanging off the link — no columns, no cards, and none of
                the mega's full-bar chrome for what is only a short list.
              {%- endcomment -%}
              <div class="cwc_header__item cwc_header__item--has-dropdown">
                <a
                  href="{{ link.url }}"
                  class="cwc_header__link{% if link.active or link.child_active %} cwc_header__link--active{% endif %}"
                >
                  {{ link.title }}
                  <svg class="cwc_header__caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </a>

                <div class="cwc_header__dropdown">
                  {% for child_link in link.links %}
                    <a
                      href="{{ child_link.url }}"
                      class="cwc_header__dropdown-link{% if child_link.active %} cwc_header__dropdown-link--active{% endif %}"
                    >
                      {{ child_link.title }}
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% else %}
              <div class="cwc_header__item">
                <a
                  href="{{ link.url }}"
                  class="cwc_header__link{% if link.active %} cwc_header__link--active{% endif %}"
                >
                  {{ link.title }}
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </nav>
      {% elsif section.blocks.size > 0 %}
        <nav class="cwc_header__nav" data-cwc-nav>
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'link' %}
                {% if block.settings.label != blank %}
                  <div class="cwc_header__item" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.link | default: '#' }}" class="cwc_header__link">
                      {{ block.settings.label }}
                    </a>
                  </div>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </nav>
      {% endif %}

      {% comment %} Utility links {% endcomment %}
      <div class="cwc_header__utility">
        {% if section.settings.show_search %}
          {%- comment -%}
            Stays a real link to the search page, so it still works if the script
            never runs. The handler cancels the navigation and opens the panel.
          {%- endcomment -%}
          <a
            href="{{ routes.search_url }}"
            class="cwc_header__icon"
            aria-label="Search"
            aria-haspopup="dialog"
            aria-expanded="false"
            data-cwc-search-open
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="6.4"></circle>
              <path d="M15.8 15.8 20 20"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_account %}
          <a href="{{ routes.account_url }}" class="cwc_header__icon" aria-label="Account">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.6"></circle>
              <path d="M4.6 20c0-4 3.3-6.2 7.4-6.2s7.4 2.2 7.4 6.2"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_cart %}
          <a href="{{ routes.cart_url }}" class="cwc_header__icon cwc_header__icon--cart" aria-label="Cart">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 7h14l-1.2 12.2H6.2z"></path>
              <path d="M9 7V5.6A3 3 0 0 1 15 5.6V7"></path>
            </svg>
            {%- comment -%}
              Rendered only when there is something in the cart, so an empty cart
              does not carry a zero badge. The drawer footer prints the same
              count as text.
            {%- endcomment -%}
            {% if cart.item_count > 0 %}
              <span class="cwc_header__cart-count" data-cwc-cart-count>{{ cart.item_count }}</span>
            {% endif %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.settings.show_search %}
    {% render 'CWC_header-search__panel', section: section %}
  {% endif %}

  {%- comment -%}
    Sibling of the bar, not a child of it. The bar carries a backdrop-filter, and
    a filtered element becomes the containing block for position:fixed
    descendants — a drawer inside it would anchor to the bar and be clipped to
    the height of the header.
  {%- endcomment -%}
  {% render 'CWC_header-drawer',
    nav_menu: nav_menu,
    section: section,
    promo_block: drawer_promo_block,
    show_counts: show_counts
  %}
</section>

{{ 'CWC_header.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "CWC Header",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Select a menu from Online Store > Navigation. Dropdowns render for any item with sub-links. Leave empty to use the manual Nav Link blocks below instead."
    },
    {
      "type": "checkbox",
      "id": "show_menu_counts",
      "label": "Show Product Counts",
      "default": true,
      "info": "Prints the number of products beside any menu link that points to a collection."
    },
    {
      "type": "range",
      "id": "mobile_breakpoint",
      "label": "Collapse To Drawer Below",
      "min": 700,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 1000,
      "info": "Above this width the nav shows in the bar; below it, the burger and drawer take over."
    },
    {
      "type": "checkbox",
      "id": "drawer_open_first",
      "label": "Open First Menu Group In Drawer",
      "default": true,
      "info": "The drawer opens onto real links rather than a list of closed headings."
    },
    {
      "type": "header",
      "content": "Navigation (Wholesale Customers)"
    },
    {
      "type": "link_list",
      "id": "menu_wholesale",
      "label": "Menu (Wholesale Customers)",
      "info": "Shown instead of the menu above to logged-in customers tagged 'wholesale'. Leave empty and wholesale customers see the standard menu."
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image",
      "info": "Optional. Overrides the text wordmark below."
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo Alt Text",
      "default": "NanoGreens"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Image Height — Desktop",
      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo Image Height — Mobile",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "text",
      "id": "logo_text_lead",
      "label": "Wordmark — Leading Word",
      "default": "nano"
    },
    {
      "type": "text",
      "id": "logo_text_accent",
      "label": "Wordmark — Accent Word",
      "default": "greens"
    },
    {
      "type": "range",
      "id": "logo_text_size",
      "label": "Wordmark Text Size — Desktop",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22,
      "info": "Applies when no Logo Image is set."
    },
    {
      "type": "range",
      "id": "logo_text_size_mobile",
      "label": "Wordmark Text Size — Mobile",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Utility Links"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Search Panel"
    },
    {
      "type": "paragraph",
      "content": "The search icon opens a panel under the header with live product results. Which products match is controlled by the Search & Discovery app."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder Text",
      "default": "Search products"
    },
    {
      "type": "text",
      "id": "search_popular_label",
      "label": "Popular Searches Heading",
      "default": "Popular searches"
    },
    {
      "type": "text",
      "id": "search_popular",
      "label": "Popular Searches",
      "info": "Comma separated. Shown as tappable chips before the shopper types.",
      "default": "greens, collagen, bundles, weight loss"
    },
    {
      "type": "range",
      "id": "search_limit",
      "label": "Results Shown",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "search_min_chars",
      "label": "Characters Before Searching",
      "info": "Lower values search sooner but fire more requests.",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "search_panel_height",
      "label": "Panel Height",
      "info": "Share of the screen height the panel may fill on desktop. Full screen on mobile regardless.",
