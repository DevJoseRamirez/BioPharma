  "presets": [
    {
      "name": "Labor Day Hero",
      "category": "CWC Custom",
      "blocks": [
        { "type": "offer_item" },
        { "type": "offer_item" },
        { "type": "offer_item" },
        { "type": "offer_item" }
      ]
    }
  ]
}
{% endschema %}
