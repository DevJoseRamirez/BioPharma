{% style %}
    #cwc_announcement-nav-{{ section.id }} {
      --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
      --text-color: {{ section.settings.text_color | default: '#5C5842' }};
      --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
      --announce-bg: {{ section.settings.announce_bg_color | default: '#44681A' }};
      --announce-text: {{ section.settings.announce_text_color | default: '#ffffff' }};
      --announce-highlight: {{ section.settings.announce_bold_color | default: '#A3C781' }};
      --logo-color: {{ section.settings.logo_color | default: '#2A2611' }};
      --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
      --padding-top: {{ section.settings.padding_top | default: 15 }}px;
      --padding-bottom: {{ section.settings.padding_bottom | default: 15 }}px;
      --padding-top-mobile: {{ section.settings.padding_top | default: 15 | times: 0.5 }}px;
      --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 15 | times: 0.5 }}px;
    }

  .announcement-bar-section,
  footer,
    sticky-header {
      display: none !important;
    }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_announcement_nav.css' | asset_url | stylesheet_tag }}

<section
  id="cwc_announcement-nav-{{ section.id }}"
  class="cwc_announcement-nav{% if section.settings.enable_sticky %} cwc_announcement-nav--sticky{% endif %}"
>
  {% if section.settings.announce_text != blank %}
    <div class="cwc_announcement-nav__announce">
      <div class="cwc_announcement-nav__announce-inner cwc-rte">
        {{ section.settings.announce_text }}
      </div>
    </div>
  {% endif %}

  <div class="cwc_announcement-nav__bar">
    <div class="cwc_announcement-nav__container">
      {% comment %} Wordmark {% endcomment %}
      <a href="{{ routes.root_url }}" class="cwc_announcement-nav__logo">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ section.settings.logo_alt | default: shop.name | escape }}"
            class="cwc_announcement-nav__logo-image"
            width="200"
            height="40"
            loading="eager"
          >
        {% else %}
          <span class="cwc_announcement-nav__logo-text">
            {%- if section.settings.logo_text_lead != blank -%}
              <span class="cwc_announcement-nav__logo-lead">{{ section.settings.logo_text_lead }}</span>
            {%- endif -%}
            {%- if section.settings.logo_text_accent != blank -%}
              <span class="cwc_announcement-nav__logo-accent">{{ section.settings.logo_text_accent }}</span>
            {%- endif -%}
          </span>
        {% endif %}
      </a>

      {% comment %} Primary links {% endcomment %}
      {% if section.blocks.size > 0 %}
        <nav class="cwc_announcement-nav__links" data-cwc-menu>
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'link' %}
                {% if block.settings.label != blank %}
                  <a
                    href="{{ block.settings.link | default: '#' }}"
                    class="cwc_announcement-nav__link"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.label }}
                  </a>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </nav>
      {% endif %}

      {% comment %} Utility links {% endcomment %}
      <div class="cwc_announcement-nav__utility">
        {% if section.settings.show_account %}
          <a href="{{ routes.account_url }}" class="cwc_announcement-nav__icon" aria-label="Account">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.6"></circle>
              <path d="M4.6 20c0-4 3.3-6.2 7.4-6.2s7.4 2.2 7.4 6.2"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_search %}
          <a href="{{ routes.search_url }}" class="cwc_announcement-nav__icon" aria-label="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="6.4"></circle>
              <path d="M15.8 15.8 20 20"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_cart %}
          <a href="{{ routes.cart_url }}" class="cwc_announcement-nav__icon" aria-label="Cart">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 7h14l-1.2 12.2H6.2z"></path>
              <path d="M9 7V5.6A3 3 0 0 1 15 5.6V7"></path>
            </svg>
          </a>
        {% endif %}

        <button
          type="button"
          class="cwc_announcement-nav__toggle"
          aria-label="Menu"
          aria-expanded="false"
          data-cwc-toggle
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</section>

{{ 'CWC_announcement_nav.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "CWC Announcement + Nav",
  "settings": [
    {
      "type": "header",
      "content": "Announcement"
    },
    {
      "type": "richtext",
      "id": "announce_text",
      "label": "Announcement Text",
      "default": "<p>Free shipping on subscriptions &middot; <strong>30-day money-back guarantee</strong> &middot; Formulated with clinicians since 2010</p>"
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image",
      "info": "Optional. Overrides the text wordmark below."
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo Alt Text",
      "default": "NanoGreens"
    },
    {
      "type": "text",
      "id": "logo_text_lead",
      "label": "Wordmark — Leading Word",
      "default": "nano"
    },
    {
      "type": "text",
      "id": "logo_text_accent",
      "label": "Wordmark — Accent Word",
      "default": "greens"
    },
    {
      "type": "header",
      "content": "Utility Links"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Stick Nav To Top On Scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Nav Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Nav Link Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Wordmark Accent Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Wordmark Base Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E6E5DC"
    },
    {
      "type": "header",
      "content": "Announcement Colors"
    },
    {
      "type": "color",
      "id": "announce_bg_color",
      "label": "Announcement Background Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "announce_text_color",
      "label": "Announcement Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "announce_bold_color",
      "label": "Announcement Bold Color",
      "default": "#A3C781"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Announcement + Nav",
      "category": "CWC Custom",
      "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }]
    }
  ]
}
{% endschema %}
