{% style %}
  #cwc_home-by-format-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --columns-desktop: {{ section.settings.columns_desktop | default: 6 }};
    --padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 50 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 50 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_home_by_format.css' | asset_url | stylesheet_tag }}

<div id="cwc_home-by-format--anchor"></div>

<section id="cwc_home-by-format-{{ section.id }}" class="cwc_home-by-format">
  <div class="cwc_home-by-format__container">
    {% comment %} Section Header {% endcomment %}
    <div class="cwc_home-by-format__content">
      {% if section.settings.eyebrow != blank %}
        <div class="cwc_home-by-format__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_home-by-format__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_home-by-format__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} Format Cards {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_home-by-format__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'format' %}
              {% liquid
                # Override → collection → nothing, for every field on the card.
                assign card_collection = block.settings.collection

                if card_collection != blank
                  assign card_link = card_collection.url
                elsif block.settings.link != blank
                  assign card_link = block.settings.link
                else
                  assign card_link = null
                endif

                if block.settings.image != blank
                  assign card_image = block.settings.image
                elsif card_collection != blank and card_collection.image != blank
                  assign card_image = card_collection.image
                else
                  assign card_image = null
                endif

                if block.settings.title != blank
                  assign card_title = block.settings.title
                elsif card_collection != blank
                  assign card_title = card_collection.title
                else
                  assign card_title = blank
                endif

                if block.settings.count_text != blank
                  assign card_count = block.settings.count_text
                elsif card_collection != blank
                  assign product_total = card_collection.all_products_count
                  if product_total == 1
                    assign count_suffix = section.settings.count_suffix_singular | default: 'product'
                  else
                    assign count_suffix = section.settings.count_suffix_text | default: 'products'
                  endif
                  assign card_count = product_total | append: ' ' | append: count_suffix
                else
                  assign card_count = blank
                endif
              %}

              {% if card_link != blank %}
                <a href="{{ card_link }}" class="cwc_home-by-format__card" {{ block.shopify_attributes }}>
              {% else %}
                <div class="cwc_home-by-format__card" {{ block.shopify_attributes }}>
              {% endif %}

              <div class="cwc_home-by-format__card-image">
                {% if card_image != blank %}
                  <img
                    src="{{ card_image | image_url: width: 300 }}"
                    alt="{{ block.settings.image_alt | default: card_title | escape }}"
                    width="300"
                    height="300"
                    loading="lazy"
                  >
                {% else %}
                  <div class="cwc_home-by-format__placeholder">
                    <span>Add image</span>
                  </div>
                {% endif %}
              </div>

              {% if card_title != blank %}
                <div class="cwc_home-by-format__card-title">{{ card_title }}</div>
              {% endif %}

              {% if card_count != blank %}
                <span class="cwc_home-by-format__card-text">{{ card_count }}</span>
              {% endif %}

              {% if card_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cwc_home-by-format__empty">
        <p>Add format blocks to display content.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CWC Home By Format",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Or start with the shelf"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>However you’d <strong>rather take it.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Powders, capsules, gummies and liquids — seventeen products, the same formulation approach behind all of them.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns On Desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted Text Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#5BA90F"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card Hover Border Color",
      "default": "#E6E5DC"
    },
    {
      "type": "header",
      "content": "Product Count"
    },
    {
      "type": "text",
      "id": "count_suffix_text",
      "label": "Product Count Suffix",
      "info": "Used when a card's count comes from its collection.",
      "default": "products"
    },
    {
      "type": "text",
      "id": "count_suffix_singular",
      "label": "Product Count Suffix (Singular)",
      "default": "product"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "format",
      "name": "Format Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Card Collection",
          "info": "The card takes its link, image, title and product count from this collection."
        },
        {
          "type": "header",
          "content": "Overrides (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the collection image."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Product Image Alt Text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Falls back to the collection title.",
          "default": "Greens & Reds"
        },
        {
          "type": "text",
          "id": "count_text",
          "label": "Product Count Text",
          "info": "Falls back to the collection's product count.",
          "default": "5 products"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link",
          "info": "Used only when no collection is selected."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Home By Format",
      "category": "CWC Custom",
      "blocks": [
        { "type": "format" },
        { "type": "format" },
        { "type": "format" },
        { "type": "format" },
        { "type": "format" },
        { "type": "format" }
      ]
    }
  ]
}
{% endschema %}
