{% style %}
  #cwc_home-by-format-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --columns-desktop: {{ section.settings.columns_desktop | default: 6 }};
    --padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 50 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 50 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_home_by_format.css' | asset_url | stylesheet_tag }}

<section id="cwc_home-by-format-{{ section.id }}" class="cwc_home-by-format">
  <div class="cwc_home-by-format__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_home-by-format__content">
      {% if section.settings.eyebrow != blank %}
        <div class="cwc_home-by-format__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_home-by-format__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_home-by-format__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} Format Cards {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_home-by-format__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'format' %}
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="cwc_home-by-format__card" {{ block.shopify_attributes }}>
              {% else %}
                <div class="cwc_home-by-format__card" {{ block.shopify_attributes }}>
              {% endif %}

                <div class="cwc_home-by-format__card-image">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 300 }}"
                      alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                      width="300"
                      height="300"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="cwc_home-by-format__placeholder">
                      <span>Add image</span>
                    </div>
                  {% endif %}
                </div>

                {% if block.settings.title != blank %}
                  <div class="cwc_home-by-format__card-title">{{ block.settings.title }}</div>
                {% endif %}

                {% if block.settings.count_text != blank %}
                  <span class="cwc_home-by-format__card-text">{{ block.settings.count_text }}</span>
                {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cwc_home-by-format__empty">
        <p>Add format blocks to display content.</p>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "CWC Home By Format",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Or start with the shelf"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>However you’d <strong>rather take it.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Powders, capsules, gummies and liquids — seventeen products, the same formulation approach behind all of them.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns On Desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted Text Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#5BA90F"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card Hover Border Color",
      "default": "#E6E5DC"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "format",
      "name": "Format Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Product Image Alt Text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Greens & Reds"
        },
        {
          "type": "text",
          "id": "count_text",
          "label": "Product Count Text",
          "default": "5 products"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Home By Format",
      "category": "CWC Custom",
      "blocks": [
        { "type": "format" },
        { "type": "format" },
        { "type": "format" },
        { "type": "format" },
        { "type": "format" },
        { "type": "format" }
      ]
    }
  ]
}
{% endschema %}
