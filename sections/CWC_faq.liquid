{% style %}
  #cwc_faq-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --panel-bg: {{ section.settings.panel_bg_color | default: '#44681A' }};
    --panel-text: {{ section.settings.panel_text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#A3C781' }};
    --answer-color: {{ section.settings.answer_color | default: '#dbe6cd' }};
    --divider-color: {{ section.settings.divider_color | default: 'rgba(255,255,255,0.22)' }};
    --sign-color: {{ section.settings.sign_color | default: '#ffffff' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#31501A' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 0 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 0 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 0 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_faq.css' | asset_url | stylesheet_tag }}

<section
  id="cwc_faq-{{ section.id }}"
  class="cwc_faq{% if section.settings.image_position == 'left' %} cwc_faq--reverse{% endif %}"
>
  <div class="cwc_faq__wrapper">

    {% comment %} Content panel {% endcomment %}
    <div class="cwc_faq__panel">
      <div class="cwc_faq__panel-inner">

        {% if section.settings.heading != blank %}
          <div class="cwc_faq__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="cwc_faq__list">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'faq' %}
                  <details
                    class="cwc_faq__item"
                    {% if block.settings.open %}open{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <summary class="cwc_faq__question">
                      <span class="cwc_faq__question-text">{{ block.settings.question }}</span>
                      <span class="cwc_faq__sign" aria-hidden="true"></span>
                    </summary>
                    {% if block.settings.answer != blank %}
                      <div class="cwc_faq__answer cwc-rte">{{ block.settings.answer }}</div>
                    {% endif %}
                  </details>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="cwc_faq__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

      </div>
    </div>

    {% comment %} Media {% endcomment %}
    <div class="cwc_faq__media">
      {% if section.settings.image != blank %}
        {% if section.settings.image_mobile != blank %}
          <picture>
            <source
              media="(max-width: 767px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 900 }}"
            >
            <img
              src="{{ section.settings.image | image_url: width: 1400 }}"
              alt="{{ section.settings.image_alt | default: 'NanoGreens' | escape }}"
              loading="lazy"
              width="1400"
              height="1400"
            >
          </picture>
        {% else %}
          <img
            src="{{ section.settings.image | image_url: width: 1400 }}"
            alt="{{ section.settings.image_alt | default: 'NanoGreens' | escape }}"
            loading="lazy"
            width="1400"
            height="1400"
          >
        {% endif %}
      {% else %}
        <div class="cwc_faq__placeholder">
          <span>Add image</span>
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "CWC FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>FAQs</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "Explore all FAQs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image",
      "info": "Optional. Falls back to the main image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "NanoGreens"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Panel Background Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Panel Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#A3C781"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer Text Color",
      "default": "#dbe6cd"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#6a8348"
    },
    {
      "type": "color",
      "id": "sign_color",
      "label": "Toggle Sign Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#31501A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I take it?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Mix 1 scoop (12g) with 6–16 oz of cold water. Shake, stir, or blend.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open By Default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "FAQ",
      "category": "CWC Custom",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
