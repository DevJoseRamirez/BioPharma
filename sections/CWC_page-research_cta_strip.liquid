{% style %}
  #cwc_page-research-cta-strip-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#f4f3ee' }};
    --heading-color: {{ section.settings.heading_color | default: '#2A2611' }};
    --text-color: {{ section.settings.text_color | default: '#666666' }};
    --highlight-color: {{ section.settings.bold_color | default: '#2A2611' }};
    --border-color: {{ section.settings.border_color | default: '#E2E1D6' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#44681A' }};
    --button-bg-hover: {{ section.settings.button_hover_color | default: '#5BA90F' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 60 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_page-research_cta_strip.css' | asset_url | stylesheet_tag }}

<section id="cwc_page-research-cta-strip-{{ section.id }}" class="cwc_page-research-cta-strip">
  <div class="cwc_page-research-cta-strip__container">
    {% comment %} Section Header {% endcomment %}
    <div class="cwc_page-research-cta-strip__content">
      {% if section.settings.heading != blank %}
        <div class="cwc_page-research-cta-strip__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_page-research-cta-strip__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}

      {% if section.settings.cta_text != blank %}
        <div class="cwc_page-research-cta-strip__button">
          {% if section.settings.cta_link != blank %}
            <a href="{{ section.settings.cta_link }}" class="cwc_page-research-cta-strip__button-link">
              {{ section.settings.cta_text }}
              <span class="cwc_page-research-cta-strip__button-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {% else %}
            <span class="cwc_page-research-cta-strip__button-link">
              {{ section.settings.cta_text }}
              <span class="cwc_page-research-cta-strip__button-arrow" aria-hidden="true">&rarr;</span>
            </span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Research CTA",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Ready to <strong>experience it yourself<\/strong>?<\/p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>30-day money-back guarantee. Free shipping on subscriptions. Cancel anytime.<\/p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Shop NanoGreens"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f3ee"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Top Border Color",
      "default": "#E2E1D6"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Page Research CTA",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
