{%- liquid
  assign hero_product = section.settings.product | default: product
  assign current_variant = hero_product.selected_or_first_available_variant
  assign gallery_limit = section.settings.gallery_limit | default: 10
-%}

{%- comment -%}
  How long each selling plan's charge covers, in days, gathered off the supply
  cards before any pricing is printed.

  A quarterly plan bills three months at once, and quoting that whole charge
  against a monthly plan's would compare a quarter with a month. So every price
  in this section is per 4 weeks — a month being 4 weeks here, so the headline
  times the interval reconciles to the total the card says it bills — and the
  interval has to be known here rather than only inside the card: the payload
  below is what the script re-prices from when the flavour changes, so both
  routes have to scale by the same number or the card would change price the
  moment it was touched.

  Only plans on an interval other than 4 weeks are listed, which keeps the lookup
  below empty on a setup where every card bills monthly.
{%- endcomment -%}
{%- liquid
  assign slot_numbers = '1,2,3,4' | split: ','
  assign plan_intervals = ''

  for buy_box_block in section.blocks
    if buy_box_block.type == 'supply'
      for slot_number in slot_numbers
        assign key = 'opt' | append: slot_number | append: '_selling_plan_id'
        assign slot_plan = buy_box_block.settings[key] | remove: '#' | strip

        assign key = 'opt' | append: slot_number | append: '_billing_interval_count'
        assign slot_count = buy_box_block.settings[key] | default: 1
        if slot_count < 1
          assign slot_count = 1
        endif

        assign key = 'opt' | append: slot_number | append: '_billing_interval_unit'
        assign slot_unit = buy_box_block.settings[key] | default: 'week'

        case slot_unit
          when 'day'
            assign slot_unit_days = 1
          when 'month'
            assign slot_unit_days = 28
          else
            assign slot_unit_days = 7
        endcase

        assign slot_days = slot_count | times: slot_unit_days

        if slot_plan != blank and slot_days != 28
          assign plan_intervals = plan_intervals | append: slot_plan | append: ':' | append: slot_days | append: ','
        endif
      endfor
    endif
  endfor

  assign plan_interval_pairs = plan_intervals | split: ','
-%}

{%- capture variant_payload -%}
  [
  {%- for variant in hero_product.variants -%}
    {
      "id": {{ variant.id }},
      "available": {{ variant.available }},
      "title": {{ variant.title | json }},
      {%- comment -%}
        Option values by position, so the script can resolve a variant from a
        combination of choices — flavour and supply are separate options now,
        and picking one has to keep the other.
      {%- endcomment -%}
      "options": [{{ variant.option1 | json }}, {{ variant.option2 | json }}, {{ variant.option3 | json }}],
      "price": {{ variant.price | money | json }},
      "compare": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money | json }}{%- else -%}""{%- endif -%},
      {%- comment -%}
        Savings are worked out here rather than in the script, because the money
        strings above are already formatted and subtracting two of them in JS
        would mean parsing a currency the merchant is free to change. Both
        shapes ship — the price display block picks the one its setting asks
        for, and neither costs anything when the block is not used.
      {%- endcomment -%}
      "save": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | minus: variant.price | money | json }}{%- else -%}""{%- endif -%},
      "save_pct": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round | json }}{%- else -%}""{%- endif -%},
      "image": {%- if variant.image != blank -%}{{ variant.image | image_url: width: 900 | json }}{%- else -%}""{%- endif -%},
      "media_id": {%- if variant.featured_media != blank -%}{{ variant.featured_media.id }}{%- else -%}0{%- endif -%},
      "plans": {
        {%- for allocation in variant.selling_plan_allocations -%}
          {%- liquid
            comment
              Per 4 weeks, so a quarterly card reads against a monthly one. Cents
              are scaled before they are formatted, which keeps the rounding to a
              single place rather than to each of the three numbers.
            endcomment
            assign interval_days = 28
            for pair in plan_interval_pairs
              assign pair_parts = pair | split: ':'
              assign pair_plan = pair_parts[0] | plus: 0
              if pair_plan == allocation.selling_plan.id
                assign interval_days = pair_parts[1] | plus: 0
              endif
            endfor

            assign plan_now = allocation.price | times: 28 | divided_by: interval_days
            assign plan_then = allocation.compare_at_price | times: 28 | divided_by: interval_days
          -%}
          "{{ allocation.selling_plan.id }}": {
            "price": {{ plan_now | money | json }},
            {%- comment -%} undivided, for the "billed X every Y" strip {%- endcomment -%}
            "total": {{ allocation.price | money_with_currency | json }},
            "compare": {%- if plan_then > plan_now -%}{{ plan_then | money | json }}{%- else -%}""{%- endif -%},
            "save": {%- if plan_then > plan_now -%}{{ plan_then | minus: plan_now | money | json }}{%- else -%}""{%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  ]
{%- endcapture -%}

<section
  id="cwc_product-hero-buy-box-{{ section.id }}"
  class="cwc_product-hero-buy-box"
  data-cwc-variants="{{ variant_payload | strip_newlines | escape }}"
>
  <div class="cwc_product-hero-buy-box__container">
    <div class="cwc_product-hero-buy-box__wrapper">
      {% comment %} Gallery {% endcomment %}
      {%- comment -%}
        The badge belongs to the first image, not to the gallery frame, so it
        lives inside the first slide and scrolls away with it. Captured once
        because the carousel and the single-image fallback both need it.
      {%- endcomment -%}
      {%- capture gallery_badge -%}
        {%- if section.settings.badge_text != blank -%}
          <span class="cwc_product-hero-buy-box__gallery-badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}
      {%- endcapture -%}

      <div class="cwc_product-hero-buy-box__gallery">
        <div class="cwc_product-hero-buy-box__gallery-main">
          {%- comment -%}
            One slide per media item, in the same order and under the same limit
            as the thumbnails, so slide index and thumb index always line up.
            The track is a scroll-snap carousel: swiping it is native scrolling,
            which is what gives the images real drag-and-snap on touch.
          {%- endcomment -%}
          {% if hero_product.media.size > 0 %}
            <div class="cwc_product-hero-buy-box__slides" data-cwc-gallery-track>
              {% for media in hero_product.media limit: gallery_limit %}
                <div
                  class="cwc_product-hero-buy-box__slide"
                  data-cwc-slide
                  data-cwc-media-id="{{ media.id }}"
                >
                  {% if forloop.first %}
                    {{ gallery_badge }}
                  {% endif %}

                  <img
                    src="{{ media | image_url: width: 1200 }}"
                    alt="{{ media.alt | default: hero_product.title | escape }}"
                    width="1200"
                    height="1200"
                    {% if forloop.first %}
                      loading="eager"
                    {% else %}
                      loading="lazy"
                    {% endif %}
                  >
                </div>
              {% endfor %}
            </div>
          {% elsif hero_product.featured_image != blank %}
            {{ gallery_badge }}
            <img
              src="{{ hero_product.featured_image | image_url: width: 1200 }}"
              alt="{{ hero_product.title | escape }}"
              width="1200"
              height="1200"
              loading="eager"
              data-cwc-gallery-image
            >
          {% else %}
            <div class="cwc_product-hero-buy-box__placeholder">
              <span>Product image</span>
            </div>
          {% endif %}
        </div>

        {% if section.settings.show_thumbnails and hero_product.media.size > 1 %}
          <div class="cwc_product-hero-buy-box__thumbs-wrap" data-cwc-thumbs-wrap>
            <button
              type="button"
              class="cwc_product-hero-buy-box__thumbs-arrow cwc_product-hero-buy-box__thumbs-arrow--prev"
              data-cwc-thumbs-prev
              aria-label="Previous images"
              hidden
            >
              <span aria-hidden="true">&#8249;</span>
            </button>

            <div class="cwc_product-hero-buy-box__thumbs" data-cwc-thumbs-scroller>
              {% for media in hero_product.media limit: gallery_limit %}
                <button
                  type="button"
                  class="cwc_product-hero-buy-box__thumb{% if forloop.first %} cwc_product-hero-buy-box__thumb--active{% endif %}"
                  data-cwc-thumb="{{ media | image_url: width: 1200 }}"
                  aria-label="{{ media.alt | default: hero_product.title | escape }}"
                >
                  <img
                    src="{{ media | image_url: width: 320 }}"
                    alt="{{ media.alt | default: hero_product.title | escape }}"
                    width="320"
                    height="240"
                    loading="lazy"
                  >
                </button>
              {% endfor %}
            </div>

            <button
              type="button"
              class="cwc_product-hero-buy-box__thumbs-arrow cwc_product-hero-buy-box__thumbs-arrow--next"
              data-cwc-thumbs-next
              aria-label="More images"
              hidden
            >
              <span aria-hidden="true">&#8250;</span>
            </button>
          </div>
        {% endif %}

        {% if section.settings.nutrition_label != blank and section.settings.nutrition_button_text != blank %}
          <button type="button" class="cwc_product-hero-buy-box__nutrition-button" data-cwc-nutrition-open>
            <span class="cwc_product-hero-buy-box__nutrition-icon" aria-hidden="true">&#9636;</span>
            {{ section.settings.nutrition_button_text }}
          </button>
        {% endif %}

        {%- comment -%}
          Media-column blocks. These render here, under the thumbnails, instead
          of in the buy-box loop below. That loop's case statement has no branch
          for this block type, so a media_popup block can never leak into the
          right-hand column.
        {%- endcomment -%}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'media_popup' %}
              {% render 'CWC_pdp-media-popup__block', block: block %}
          {% endcase %}
        {% endfor %}
      </div>

      {%- comment -%}
        ===== Buy box =====

        Every element in this column is a block, rendered in the order the
        merchant set in the editor — there are no hardcoded positions left.

        The loop is captured once, then rendered inside the real product form
        when a product is set, or a plain div (non-functional preview) when not:
        a Liquid form tag cannot be split across if branches. The form wraps the
        whole loop, which is what lets a block sit either side of Add To Cart.
      {%- endcomment -%}
      <div class="cwc_product-hero-buy-box__content">
        {%- capture buy_box_blocks -%}
          {% for block in section.blocks %}
            {% case block.type %}
              {%- comment -%}
                App blocks. Anything a merchant adds from an installed app —
                a review widget, a subscription widget, an upsell — renders
                here, in whatever position it was dragged to, so an app widget
                can sit anywhere among the native blocks rather than only above
                or below them.

                No shopify_attributes on the wrapper: an app block carries its
                own, and adding a second set here would give the editor two
                targets for the one block.

                The wrapper is only for spacing, so a widget that ships with no
                margins of its own does not butt up against the block above it.

                Note this renders inside the product form. A widget that posts
                its own <form> cannot be nested here — put that one in its own
                section instead.
              {%- endcomment -%}
              {% when '@app' %}
                <div class="cwc_product-hero-buy-box__app-block">
                  {% render block %}
                </div>

              {% when 'rating' %}
                {% render 'CWC_pdp-rating__block', block: block %}

              {% when 'title' %}
                {% render 'CWC_pdp-title__block', block: block, product: hero_product %}

              {%- comment -%}
                The gradient alternative to the block above: one heading, no
                eyebrow, painted with the block's own two colours.
              {%- endcomment -%}
              {% when 'gradient_title' %}
                {% render 'CWC_pdp-gradient-title__block', block: block, product: hero_product %}

              {% when 'desc' %}
                {% render 'CWC_pdp-desc__block', block: block, product: hero_product %}

              {% when 'text' %}
                {% render 'CWC_pdp-text__block', block: block %}

              {% when 'benefits' %}
                {% render 'CWC_pdp-benefits__block', block: block %}

              {%- comment -%}
                The same rows, filled from the product's own metafield rather
                than typed into the block — for templates shared across products
                that each sell on different points.
              {%- endcomment -%}
              {% when 'benefits_meta' %}
                {% render 'CWC_pdp-benefits-meta__block', block: block, product: hero_product %}

              {% when 'benefit_icons' %}
                {% render 'CWC_pdp-benefit-icons__block', block: block %}

              {% when 'trusted_by' %}
                {% render 'CWC_pdp-trusted-by__block', block: block %}

              {% when 'delivery_estimate' %}
                {% render 'CWC_pdp-delivery-estimate__block', block: block %}

              {% when 'key_benefits' %}
                {% render 'CWC_pdp-key-benefits__block', block: block %}

              {%- comment -%}
                The same pills, filled from the product's own metafield rather
                than typed into the block — for templates shared across products
                that each sell on different points.
              {%- endcomment -%}
              {% when 'benefit_lines' %}
                {% render 'CWC_pdp-benefit-lines__block', block: block, product: hero_product %}

              {%- comment -%}
                The plain price row. Every other number in this buy box comes
                off a selling plan, so a product with no plans renders with no
                price at all without this block.
              {%- endcomment -%}
              {% when 'price_display' %}
                {% render 'CWC_pdp-price-display__block',
                  block: block,
                  current_variant: current_variant
                %}

              {% when 'flavors' %}
                {% render 'CWC_pdp-flavors__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant
                %}

              {% when 'product_options' %}
                {%- comment -%}
                  The generic picker: it reads the product's own options rather
                  than being told which one to show, so a template shared across
                  products with different option sets still renders the right
                  controls on each. Renders nothing on a single-variant product.
                {%- endcomment -%}
                {% render 'CWC_pdp-product-options__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant
                %}

              {% when 'supply' %}
                {%- comment -%}
                  One block renders the whole group now, so the label belongs to
                  the render rather than to a running count of cards.
                {%- endcomment -%}
                {% render 'CWC_pdp-supply-option__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant,
                  section_id: section.id,
                  group_label: block.settings.group_label
                %}

              {% when 'purchase_plans' %}
                {%- comment -%}
                  The typed-nothing alternative to the supply block: one card per
                  selling plan the product actually carries. Use one or the
                  other — both share the radio group, so both at once would let a
                  shopper appear to hold two selections.
                {%- endcomment -%}
                {% render 'CWC_pdp-purchase-plans__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant,
                  section_id: section.id
                %}

              {%- comment -%}
                The single-plan alternative to purchase_plans + onetime. It
                renders both cards itself, so it replaces the pair rather than
                joining them — see the snippet's header.
              {%- endcomment -%}
              {% when 'simple_offer' %}
                {% render 'CWC_pdp-simple-offer__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant,
                  section_id: section.id
                %}

              {% when 'onetime' %}
                {% render 'CWC_pdp-onetime__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant
                %}

              {% when 'add_to_cart' %}
                {% render 'CWC_pdp-atc__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant
                %}

              {% when 'clinicians' %}
                {% render 'CWC_pdp-clinicians__block', block: block %}

              {% when 'trust_icons' %}
                {% render 'CWC_pdp-trust-icons__block', block: block %}

              {% when 'stats_panel' %}
                {% render 'CWC_pdp-stats-panel__block', block: block %}

              {% when 'detail' %}
                {% render 'CWC_pdp-detail__block', block: block %}

              {% when 'sticky_atc' %}
                {% render 'CWC_pdp-sticky-atc__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant
                %}
            {% endcase %}
          {% endfor %}
        {%- endcapture -%}

        {%- comment -%}
          is="product-form" hands the submit to the theme's own ProductForm
          element: it POSTs to /cart/add.js, then fires cart:change, which is
          what makes the cart drawer open. Without it the browser does a native
          POST and lands the shopper on /cart, off the page entirely.

          Every add in this section — main button, sticky bar, one-time link —
          goes through this one form, so they all inherit that behaviour.
        {%- endcomment -%}
        {% if hero_product != blank %}
          {% form 'product',
            hero_product,
            class: 'cwc_product-hero-buy-box__form',
            novalidate: 'novalidate',
            is: 'product-form'
          %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-cwc-variant-input>
            <input type="hidden" name="quantity" value="1" data-cwc-quantity-input>
            {%- comment -%}
              Starts disabled so it is not submitted at all until a plan is
              actually chosen — cart rejects an empty selling_plan. The script
              enables it when a subscription option is selected.
            {%- endcomment -%}
            <input type="hidden" name="selling_plan" value="" data-cwc-plan-input disabled>
            {{ buy_box_blocks }}
          {% endform %}
        {% else %}
          <div class="cwc_product-hero-buy-box__form">
            {{ buy_box_blocks }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% comment %} Nutrition label modal {% endcomment %}
  {% if section.settings.nutrition_label != blank %}
    <div class="cwc_product-hero-buy-box__modal" data-cwc-nutrition-modal hidden>
      <div class="cwc_product-hero-buy-box__modal-inner">
        <button type="button" class="cwc_product-hero-buy-box__modal-close" aria-label="Close" data-cwc-nutrition-close>
          &times;
        </button>
        <img
          src="{{ section.settings.nutrition_label | image_url: width: 1200 }}"
          alt="{{ section.settings.nutrition_alt | default: 'Supplement facts' | escape }}"
          width="1200"
          height="1600"
          loading="lazy"
        >
      </div>
    </div>
  {% endif %}

  {% comment %} Media popup overlays — one per media_popup block {% endcomment %}
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'media_popup' %}
        {% render 'CWC_pdp-media-popup__modal', block: block %}
    {% endcase %}
  {% endfor %}
</section>

{{ 'CWC_product_hero_buy_box.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "CWC Hero Buy Box",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "The product this buy box sells. Drives the gallery, flavors, prices, and add-to-cart. If left empty, falls back to the template's current product."
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Image Badge Text",
      "default": "55 organic ingredients"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Main Image Shape",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Tall (3:4)"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Main Image Fit",
      "info": "Fill crops the image to the frame. Fit shows the whole image — better for packshots on white.",
      "options": [
        {
          "value": "cover",
          "label": "Fill the frame"
        },
        {
          "value": "contain",
          "label": "Fit inside the frame"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show Thumbnails",
      "default": true
    },
    {
      "type": "range",
      "id": "gallery_limit",
      "label": "Maximum Thumbnails",
      "info": "Extra images scroll horizontally behind the arrows.",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "thumbs_per_view",
      "label": "Thumbnails Per View",
      "info": "How many fit across before scrolling. One fewer is shown on mobile.",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "thumb_ratio",
      "label": "Thumbnail Shape",
      "options": [
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "text",
      "id": "nutrition_button_text",
      "label": "Nutrition Button Text",
      "default": "View Nutrition Label"
    },
