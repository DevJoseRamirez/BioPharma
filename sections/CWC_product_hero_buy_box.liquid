{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_product_hero_buy_box.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  The sticky bar is a block of this section now, but keeps its own stylesheet
  and class names so its styles did not have to be rewritten when it moved.
{%- endcomment -%}
{{ 'CWC_sticky_add_to_cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_product = section.settings.product | default: product
  assign current_variant = hero_product.selected_or_first_available_variant
  assign gallery_limit = section.settings.gallery_limit | default: 10
-%}

{%- comment -%}
  How many months each selling plan charges for, gathered off the supply cards
  before any pricing is printed.

  A quarterly plan bills three months at once, and quoting that whole charge
  against a monthly plan's would compare a quarter with a month. So every price
  in this section is per month, and the divisor has to be known here rather than
  only inside the card: the payload below is what the script re-prices from when
  the flavour changes, so both routes have to divide by the same number or the
  card would change price the moment it was touched.

  Only plans that bill for more than one month are listed, which keeps the
  lookup below empty on the ordinary all-monthly setup.
{%- endcomment -%}
{%- liquid
  assign slot_numbers = '1,2,3,4' | split: ','
  assign plan_months = ''

  for buy_box_block in section.blocks
    if buy_box_block.type == 'supply'
      for slot_number in slot_numbers
        assign key = 'opt' | append: slot_number | append: '_selling_plan_id'
        assign slot_plan = buy_box_block.settings[key] | remove: '#' | strip

        assign key = 'opt' | append: slot_number | append: '_billing_months'
        assign slot_months = buy_box_block.settings[key] | default: 1

        if slot_plan != blank and slot_months > 1
          assign plan_months = plan_months | append: slot_plan | append: ':' | append: slot_months | append: ','
        endif
      endfor
    endif
  endfor

  assign plan_month_pairs = plan_months | split: ','
-%}

{%- capture variant_payload -%}
  [
  {%- for variant in hero_product.variants -%}
    {
      "id": {{ variant.id }},
      "available": {{ variant.available }},
      "title": {{ variant.title | json }},
      {%- comment -%}
        Option values by position, so the script can resolve a variant from a
        combination of choices — flavour and supply are separate options now,
        and picking one has to keep the other.
      {%- endcomment -%}
      "options": [{{ variant.option1 | json }}, {{ variant.option2 | json }}, {{ variant.option3 | json }}],
      "price": {{ variant.price | money | json }},
      "compare": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money | json }}{%- else -%}""{%- endif -%},
      "image": {%- if variant.image != blank -%}{{ variant.image | image_url: width: 900 | json }}{%- else -%}""{%- endif -%},
      "media_id": {%- if variant.featured_media != blank -%}{{ variant.featured_media.id }}{%- else -%}0{%- endif -%},
      "plans": {
        {%- for allocation in variant.selling_plan_allocations -%}
          {%- liquid
            comment
              Per month, so a quarterly card reads against a monthly one. Cents
              divide before they are formatted, which keeps the rounding to a
              single place rather than to each of the three numbers.
            endcomment
            assign months = 1
            for pair in plan_month_pairs
              assign pair_parts = pair | split: ':'
              assign pair_plan = pair_parts[0] | plus: 0
              if pair_plan == allocation.selling_plan.id
                assign months = pair_parts[1] | plus: 0
              endif
            endfor

            assign plan_now = allocation.price | divided_by: months
            assign plan_then = allocation.compare_at_price | divided_by: months
          -%}
          "{{ allocation.selling_plan.id }}": {
            "price": {{ plan_now | money | json }},
            "compare": {%- if plan_then > plan_now -%}{{ plan_then | money | json }}{%- else -%}""{%- endif -%},
            "save": {%- if plan_then > plan_now -%}{{ plan_then | minus: plan_now | money | json }}{%- else -%}""{%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  ]
{%- endcapture -%}

<section
  id="cwc_product-hero-buy-box-{{ section.id }}"
  class="cwc_product-hero-buy-box"
  data-cwc-variants="{{ variant_payload | strip_newlines | escape }}"
>
  <div class="cwc_product-hero-buy-box__container">
    <div class="cwc_product-hero-buy-box__wrapper">
      {% comment %} Gallery {% endcomment %}
      {%- comment -%}
        The badge belongs to the first image, not to the gallery frame, so it
        lives inside the first slide and scrolls away with it. Captured once
        because the carousel and the single-image fallback both need it.
      {%- endcomment -%}
      {%- capture gallery_badge -%}
        {%- if section.settings.badge_text != blank -%}
          <span class="cwc_product-hero-buy-box__gallery-badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}
      {%- endcapture -%}

      <div class="cwc_product-hero-buy-box__gallery">
        <div class="cwc_product-hero-buy-box__gallery-main">
          {%- comment -%}
            One slide per media item, in the same order and under the same limit
            as the thumbnails, so slide index and thumb index always line up.
            The track is a scroll-snap carousel: swiping it is native scrolling,
            which is what gives the images real drag-and-snap on touch.
          {%- endcomment -%}
          {% if hero_product.media.size > 0 %}
            <div class="cwc_product-hero-buy-box__slides" data-cwc-gallery-track>
              {% for media in hero_product.media limit: gallery_limit %}
                <div
                  class="cwc_product-hero-buy-box__slide"
                  data-cwc-slide
                  data-cwc-media-id="{{ media.id }}"
                >
                  {% if forloop.first %}
                    {{ gallery_badge }}
                  {% endif %}

                  <img
                    src="{{ media | image_url: width: 1200 }}"
                    alt="{{ media.alt | default: hero_product.title | escape }}"
                    width="1200"
                    height="1200"
                    {% if forloop.first %}
                      loading="eager"
                    {% else %}
                      loading="lazy"
                    {% endif %}
                  >
                </div>
              {% endfor %}
            </div>
          {% elsif hero_product.featured_image != blank %}
            {{ gallery_badge }}
            <img
              src="{{ hero_product.featured_image | image_url: width: 1200 }}"
              alt="{{ hero_product.title | escape }}"
              width="1200"
              height="1200"
              loading="eager"
              data-cwc-gallery-image
            >
          {% else %}
            <div class="cwc_product-hero-buy-box__placeholder">
              <span>Product image</span>
            </div>
          {% endif %}
        </div>

        {% if section.settings.show_thumbnails and hero_product.media.size > 1 %}
          <div class="cwc_product-hero-buy-box__thumbs-wrap" data-cwc-thumbs-wrap>
            <button
              type="button"
              class="cwc_product-hero-buy-box__thumbs-arrow cwc_product-hero-buy-box__thumbs-arrow--prev"
              data-cwc-thumbs-prev
              aria-label="Previous images"
              hidden
            >
              <span aria-hidden="true">&#8249;</span>
            </button>

            <div class="cwc_product-hero-buy-box__thumbs" data-cwc-thumbs-scroller>
              {% for media in hero_product.media limit: gallery_limit %}
                <button
                  type="button"
                  class="cwc_product-hero-buy-box__thumb{% if forloop.first %} cwc_product-hero-buy-box__thumb--active{% endif %}"
                  data-cwc-thumb="{{ media | image_url: width: 1200 }}"
                  aria-label="{{ media.alt | default: hero_product.title | escape }}"
                >
                  <img
                    src="{{ media | image_url: width: 320 }}"
                    alt="{{ media.alt | default: hero_product.title | escape }}"
                    width="320"
                    height="240"
                    loading="lazy"
                  >
                </button>
              {% endfor %}
            </div>

            <button
              type="button"
              class="cwc_product-hero-buy-box__thumbs-arrow cwc_product-hero-buy-box__thumbs-arrow--next"
              data-cwc-thumbs-next
              aria-label="More images"
              hidden
            >
              <span aria-hidden="true">&#8250;</span>
            </button>
          </div>
        {% endif %}

        {% if section.settings.nutrition_label != blank and section.settings.nutrition_button_text != blank %}
          <button type="button" class="cwc_product-hero-buy-box__nutrition-button" data-cwc-nutrition-open>
            <span class="cwc_product-hero-buy-box__nutrition-icon" aria-hidden="true">&#9636;</span>
            {{ section.settings.nutrition_button_text }}
          </button>
        {% endif %}

        {%- comment -%}
          Media-column blocks. These render here, under the thumbnails, instead
          of in the buy-box loop below. That loop's case statement has no branch
          for this block type, so a media_popup block can never leak into the
          right-hand column.
        {%- endcomment -%}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'media_popup' %}
              {% render 'CWC_pdp-media-popup__block', block: block %}
          {% endcase %}
        {% endfor %}
      </div>

      {%- comment -%}
        ===== Buy box =====

        Every element in this column is a block, rendered in the order the
        merchant set in the editor — there are no hardcoded positions left.

        The loop is captured once, then rendered inside the real product form
        when a product is set, or a plain div (non-functional preview) when not:
        a Liquid form tag cannot be split across if branches. The form wraps the
        whole loop, which is what lets a block sit either side of Add To Cart.
      {%- endcomment -%}
      <div class="cwc_product-hero-buy-box__content">
        {%- capture buy_box_blocks -%}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'rating' %}
                {% render 'CWC_pdp-rating__block', block: block %}

              {% when 'title' %}
                {% render 'CWC_pdp-title__block', block: block, product: hero_product %}

              {% when 'key_benefits' %}
                {% render 'CWC_pdp-key-benefits__block', block: block %}

              {% when 'flavors' %}
                {% render 'CWC_pdp-flavors__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant
                %}

              {% when 'supply' %}
                {%- comment -%}
                  One block renders the whole group now, so the label belongs to
                  the render rather than to a running count of cards.
                {%- endcomment -%}
                {% render 'CWC_pdp-supply-option__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant,
                  section_id: section.id,
                  group_label: block.settings.group_label
                %}

              {% when 'onetime' %}
                {% render 'CWC_pdp-onetime__block', block: block %}

              {% when 'add_to_cart' %}
                {% render 'CWC_pdp-atc__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant
                %}

              {% when 'clinicians' %}
                {% render 'CWC_pdp-clinicians__block', block: block %}

              {% when 'trust_icons' %}
                {% render 'CWC_pdp-trust-icons__block', block: block %}

              {% when 'stats_panel' %}
                {% render 'CWC_pdp-stats-panel__block', block: block %}

              {% when 'detail' %}
                {% render 'CWC_pdp-detail__block', block: block %}

              {% when 'sticky_atc' %}
                {% render 'CWC_pdp-sticky-atc__block',
                  block: block,
                  product: hero_product,
                  current_variant: current_variant
                %}
            {% endcase %}
          {% endfor %}
        {%- endcapture -%}

        {%- comment -%}
          is="product-form" hands the submit to the theme's own ProductForm
          element: it POSTs to /cart/add.js, then fires cart:change, which is
          what makes the cart drawer open. Without it the browser does a native
          POST and lands the shopper on /cart, off the page entirely.

          Every add in this section — main button, sticky bar, one-time link —
          goes through this one form, so they all inherit that behaviour.
        {%- endcomment -%}
        {% if hero_product != blank %}
          {% form 'product',
            hero_product,
            class: 'cwc_product-hero-buy-box__form',
            novalidate: 'novalidate',
            is: 'product-form'
          %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-cwc-variant-input>
            <input type="hidden" name="quantity" value="1" data-cwc-quantity-input>
            {%- comment -%}
              Starts disabled so it is not submitted at all until a plan is
              actually chosen — cart rejects an empty selling_plan. The script
              enables it when a subscription option is selected.
            {%- endcomment -%}
            <input type="hidden" name="selling_plan" value="" data-cwc-plan-input disabled>
            {{ buy_box_blocks }}
          {% endform %}
        {% else %}
          <div class="cwc_product-hero-buy-box__form">
            {{ buy_box_blocks }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% comment %} Nutrition label modal {% endcomment %}
  {% if section.settings.nutrition_label != blank %}
    <div class="cwc_product-hero-buy-box__modal" data-cwc-nutrition-modal hidden>
      <div class="cwc_product-hero-buy-box__modal-inner">
        <button type="button" class="cwc_product-hero-buy-box__modal-close" aria-label="Close" data-cwc-nutrition-close>
          &times;
        </button>
        <img
          src="{{ section.settings.nutrition_label | image_url: width: 1200 }}"
          alt="{{ section.settings.nutrition_alt | default: 'Supplement facts' | escape }}"
          width="1200"
          height="1600"
          loading="lazy"
        >
      </div>
    </div>
  {% endif %}

  {% comment %} Media popup overlays — one per media_popup block {% endcomment %}
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'media_popup' %}
        {% render 'CWC_pdp-media-popup__modal', block: block %}
    {% endcase %}
  {% endfor %}
</section>

{{ 'CWC_product_hero_buy_box.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "CWC Hero Buy Box",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "The product this buy box sells. Drives the gallery, flavors, prices, and add-to-cart. If left empty, falls back to the template's current product."
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Image Badge Text",
      "default": "55 organic ingredients"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Main Image Shape",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Tall (3:4)"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Main Image Fit",
      "info": "Fill crops the image to the frame. Fit shows the whole image — better for packshots on white.",
      "options": [
        {
          "value": "cover",
          "label": "Fill the frame"
        },
        {
          "value": "contain",
          "label": "Fit inside the frame"
        }
      ],
      "default": "cover"
