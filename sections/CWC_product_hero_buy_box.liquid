      "type": "text",
      "id": "badge_text",
      "label": "Image Badge Text",
      "default": "55 organic ingredients"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Main Image Shape",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Tall (3:4)"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Main Image Fit",
