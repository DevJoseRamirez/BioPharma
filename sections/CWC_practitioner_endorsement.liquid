{% style %}
  #cwc_practitioner-endorsement-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#78AD49' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#4A5E8C' }};
    --accent-color: {{ section.settings.accent_color | default: '#4A5E8C' }};
    --accent-bg: {{ section.settings.accent_bg_color | default: '#EEF1F9' }};
    --accent-border: {{ section.settings.accent_border_color | default: '#A3B8E2' }};
    --padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 50 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 50 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_practitioner_endorsement.css' | asset_url | stylesheet_tag }}

<section id="cwc_practitioner-endorsement-{{ section.id }}" class="cwc_practitioner-endorsement">
  <div class="cwc_practitioner-endorsement__container">

    <div class="cwc_practitioner-endorsement__content">
      {% if section.settings.eyebrow != blank %}
        <div class="cwc_practitioner-endorsement__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_practitioner-endorsement__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_practitioner-endorsement__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} Clinicians band {% endcomment %}
    {% if section.settings.show_clinician and section.settings.clinician_text != blank %}
      <div class="cwc_practitioner-endorsement__clinician">
        {% if section.settings.clinician_initials != blank %}
          <span class="cwc_practitioner-endorsement__clinician-avatars" aria-hidden="true">
            {% assign initials = section.settings.clinician_initials | split: ',' %}
            {% for initial in initials %}
              <span class="cwc_practitioner-endorsement__clinician-avatar">{{ initial | strip }}</span>
            {% endfor %}
          </span>
        {% endif %}
        <span class="cwc_practitioner-endorsement__clinician-text cwc-rte">
          {{ section.settings.clinician_text }}
        </span>
      </div>
    {% endif %}

    {% assign practitioner_blocks = section.blocks | where: 'type', 'practitioner' %}
    {% if practitioner_blocks.size > 0 %}
      <div class="cwc_practitioner-endorsement__grid">
        {% for block in practitioner_blocks %}
          <div class="cwc_practitioner-endorsement__card" {{ block.shopify_attributes }}>
            {% if block.settings.quote != blank %}
              <div class="cwc_practitioner-endorsement__quote cwc-rte">{{ block.settings.quote }}</div>
            {% endif %}
            <div class="cwc_practitioner-endorsement__who">
              <span class="cwc_practitioner-endorsement__avatar">
                {% if block.settings.photo != blank %}
                  <img
                    src="{{ block.settings.photo | image_url: width: 100 }}"
                    alt="{{ block.settings.name | escape }}"
                    width="100"
                    height="100"
                    loading="lazy"
                  >
                {% else %}
                  PHOTO
                {% endif %}
              </span>
              <div>
                {% if block.settings.name != blank %}
                  <div class="cwc_practitioner-endorsement__name">{{ block.settings.name }}</div>
                {% endif %}
                {% if block.settings.role != blank %}
                  <div class="cwc_practitioner-endorsement__role">{{ block.settings.role }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% assign stat_blocks = section.blocks | where: 'type', 'stat' %}
    {% if stat_blocks.size > 0 %}
      <div class="cwc_practitioner-endorsement__bar">
        {% for block in stat_blocks %}
          <div class="cwc_practitioner-endorsement__stat" {{ block.shopify_attributes }}>
            {% if block.settings.value != blank %}
              <div class="cwc_practitioner-endorsement__stat-value">{{ block.settings.value }}</div>
            {% endif %}
            {% if block.settings.label != blank %}
              <div class="cwc_practitioner-endorsement__stat-label">{{ block.settings.label }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "CWC Practitioners",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recommended in practice"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>The people who recommend it <strong>see patients all day</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>NanoGreens was distributed through clinics for years before it was ever sold online. Many still stock it.</p>"
    },
    {
      "type": "header",
      "content": "Clinicians Band"
    },
    {
      "type": "checkbox",
      "id": "show_clinician",
      "label": "Show Clinicians Band",
      "default": true
    },
    {
      "type": "text",
      "id": "clinician_initials",
      "label": "Clinician Initials",
      "info": "Comma separated, e.g. DC, ND, MD",
      "default": "DC, ND, MD"
    },
    {
      "type": "richtext",
      "id": "clinician_text",
      "label": "Clinicians Text",
      "default": "<p><strong>Clinicians' choice.</strong> Recommended in practice for over 20 years, before it was ever sold online.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#78AD49"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted Text Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#4A5E8C"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E6E5DC"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4A5E8C"
    },
    {
      "type": "color",
      "id": "accent_bg_color",
      "label": "Accent Background",
      "default": "#EEF1F9"
    },
    {
      "type": "color",
      "id": "accent_border_color",
      "label": "Accent Border",
      "default": "#A3B8E2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "practitioner",
      "name": "Practitioner",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>\"I've recommended NanoGreens to patients for years.\"</p>"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name & Credentials",
          "default": "[Practitioner Name], DC"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Chiropractor · [City, State]"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "33"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "of 410 reviews mention a clinician recommended it"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Practitioner Endorsement",
      "category": "CWC Custom",
      "blocks": [
        { "type": "practitioner" },
        { "type": "practitioner" },
        { "type": "practitioner" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
