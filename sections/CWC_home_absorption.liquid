  "max_blocks": 16,
  "presets": [
    {
      "name": "Home Absorption",
      "category": "CWC Custom",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "enzyme" },
        { "type": "enzyme" },
        { "type": "enzyme" }
