{% style %}
  #cwc_cost-calculator-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#F4F3EE' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --total-bg: {{ section.settings.total_bg_color | default: '#FAF9F4' }};
    --win-bg: {{ section.settings.win_bg_color | default: '#44681A' }};
    --win-accent: {{ section.settings.win_accent_color | default: '#A3C781' }};
    --win-muted: {{ section.settings.win_muted_color | default: '#cfe0bd' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#5BA90F' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 50 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 50 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_cost_calculator.css' | asset_url | stylesheet_tag }}

<section id="cwc_cost-calculator-{{ section.id }}" class="cwc_cost-calculator">
  <div class="cwc_cost-calculator__container">

    <div class="cwc_cost-calculator__content">
      {% if section.settings.eyebrow != blank %}
        <div class="cwc_cost-calculator__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_cost-calculator__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_cost-calculator__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>


    <div class="cwc_cost-calculator__grid">
      {% comment %} Buying separately {% endcomment %}
      <div class="cwc_cost-calculator__box">
        <div class="cwc_cost-calculator__box-head">
          {% if section.settings.box_title != blank %}
            <div class="cwc_cost-calculator__box-title">{{ section.settings.box_title }}</div>
          {% endif %}
          {% if section.settings.box_subtitle != blank %}
            <div class="cwc_cost-calculator__box-subtitle">{{ section.settings.box_subtitle }}</div>
          {% endif %}
        </div>

        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'line' %}
              <div class="cwc_cost-calculator__line" {{ block.shopify_attributes }}>
                <span class="cwc_cost-calculator__line-name">
                  {{ block.settings.name }}
                  {% if block.settings.note != blank %}
                    <span class="cwc_cost-calculator__line-note">{{ block.settings.note }}</span>
                  {% endif %}
                </span>
                {% if block.settings.price != blank %}
                  <span class="cwc_cost-calculator__line-price">{{ block.settings.price }}</span>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}

        {% if section.settings.total_label != blank %}
          <div class="cwc_cost-calculator__total">
            <span>{{ section.settings.total_label }}</span>
            <span class="cwc_cost-calculator__total-value">{{ section.settings.total_value }}</span>
          </div>
        {% endif %}
      </div>

      {% comment %} Win card {% endcomment %}
      <div class="cwc_cost-calculator__win">
        {% if section.settings.win_eyebrow != blank %}
          <div class="cwc_cost-calculator__win-eyebrow">{{ section.settings.win_eyebrow }}</div>
        {% endif %}
        {% if section.settings.win_title != blank %}
          <div class="cwc_cost-calculator__win-title cwc-rte">{{ section.settings.win_title }}</div>
        {% endif %}

        <div class="cwc_cost-calculator__win-price">
          {% if section.settings.win_price != blank %}
            <span class="cwc_cost-calculator__win-price-value">{{ section.settings.win_price }}</span>
          {% endif %}
          {% if section.settings.win_price_unit != blank %}
            <span class="cwc_cost-calculator__win-price-unit">{{ section.settings.win_price_unit }}</span>
          {% endif %}
        </div>

        {% if section.settings.win_price_sub != blank %}
          <div class="cwc_cost-calculator__win-sub">{{ section.settings.win_price_sub }}</div>
        {% endif %}

        {% if section.settings.win_save_value != blank %}
          <div class="cwc_cost-calculator__win-save">
            <div class="cwc_cost-calculator__win-save-value">{{ section.settings.win_save_value }}</div>
            {% if section.settings.win_save_label != blank %}
              <div class="cwc_cost-calculator__win-save-label">{{ section.settings.win_save_label }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.win_cta_text != blank %}
          <a href="{{ section.settings.win_cta_link | default: '#' }}" class="cwc_cost-calculator__win-button">
            {{ section.settings.win_cta_text }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if section.settings.footnote != blank %}
      <div class="cwc_cost-calculator__footnote">{{ section.settings.footnote }}</div>
    {% endif %}

  </div>
</section>

