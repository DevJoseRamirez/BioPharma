{%- liquid
  comment
    Content here is global brand education; only the render condition is
    per product. The spec sets is_supplement true on every kit, so the
    conditional default is safe — "always" stays available for a template
    shared with something that is not a supplement.
  endcomment
  assign condition = section.settings.enable_condition | default: 'if_is_supplement'

  assign show_section = false
  if condition == 'always'
    assign show_section = true
  elsif product.metafields.custom.is_supplement.value
    assign show_section = true
  endif

  assign stage_blocks = section.blocks | where: 'type', 'stage'
  assign enzyme_blocks = section.blocks | where: 'type', 'enzyme'
  assign stage_columns = stage_blocks.size | at_most: 4 | at_least: 1
-%}

{%- if show_section -%}
  {% style %}
    #cwc_meta_kit_absorption-{{ section.id }} {
      --section-bg: {{ section.settings.bg_color | default: '#F7F8FB' }};
      --text-color: {{ section.settings.text_color | default: '#1F1F1C' }};
      --highlight-color: {{ section.settings.bold_color | default: '#4A5F92' }};
      --eyebrow-color: {{ section.settings.eyebrow_color | default: '#6A80B4' }};
      --stage-label-color: {{ section.settings.stage_label_color | default: '#6A80B4' }};
      --body-color: {{ section.settings.body_color | default: '#6B6B65' }};
      --card-bg: {{ section.settings.card_bg | default: '#ffffff' }};
      --border-color: {{ section.settings.border_color | default: '#CFD9EE' }};
      --chip-bg: {{ section.settings.chip_bg | default: '#FFFFFF' }};
      --chip-text: {{ section.settings.chip_text_color | default: '#6A80B4' }};
      --link-color: {{ section.settings.link_color | default: '#4A5F92' }};
      --stage-columns: {{ stage_columns }};
      --padding-top: {{ section.settings.padding_top | default: 80 }}px;
      --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
      --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
      --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
    }
  {% endstyle %}

  {{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
  {{ 'CWC_meta_kit_absorption.css' | asset_url | stylesheet_tag }}

  <section
    id="cwc_meta_kit_absorption-{{ section.id }}"
    class="cwc_meta_kit_absorption{% if section.settings.show_edges %} cwc_meta_kit_absorption--edged{% endif %}"
  >
    <div class="cwc_meta_kit_absorption__container">

      {% comment %} Section Header {% endcomment %}
      <div class="cwc_meta_kit_absorption__content">
        {% if section.settings.eyebrow_text != blank %}
          <p class="cwc_meta_kit_absorption__eyebrow">{{ section.settings.eyebrow_text }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_meta_kit_absorption__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="cwc_meta_kit_absorption__lede cwc-rte">
            {{ section.settings.body }}
          </div>
        {% endif %}
      </div>

      {% comment %} Stages {% endcomment %}
      {% if stage_blocks.size > 0 %}
        <div class="cwc_meta_kit_absorption__stages">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'stage' %}
                <div class="cwc_meta_kit_absorption__stage" {{ block.shopify_attributes }}>
                  {% if block.settings.label != blank %}
                    <span class="cwc_meta_kit_absorption__stage-label">{{ block.settings.label }}</span>
                  {% endif %}

                  {% if block.settings.title != blank %}
                    <h3 class="cwc_meta_kit_absorption__stage-title">{{ block.settings.title }}</h3>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <p class="cwc_meta_kit_absorption__stage-text">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}

      {% comment %} Enzyme chips {% endcomment %}
      {% if section.settings.show_enzymes and enzyme_blocks.size > 0 %}
        <div class="cwc_meta_kit_absorption__enzymes">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'enzyme' %}
                {% if block.settings.name != blank %}
                  <span class="cwc_meta_kit_absorption__enzyme" {{ block.shopify_attributes }}>
                    {{ block.settings.name }}
                  </span>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.link_label != blank and section.settings.link_url != blank %}
        <div class="cwc_meta_kit_absorption__links">
          <a class="cwc_meta_kit_absorption__link" href="{{ section.settings.link_url }}">
            {{ section.settings.link_label }} &rarr;
          </a>
        </div>
      {% endif %}

    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Kit Absorption",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "select",
      "id": "enable_condition",
      "label": "Show This Section",
      "info": "Kits carry is_supplement, so the conditional option shows on all of them.",
      "options": [
        { "value": "if_is_supplement", "label": "Only when the product is a supplement" },
        { "value": "always", "label": "On every product" }
      ],
      "default": "if_is_supplement"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow",
      "default": "The expensive part everyone skips"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>You are what you <b>absorb.</b></p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>An ingredient list only counts for what your body can take up. Enzymes break the formula down so it can be used — and they're the expensive line on a spec sheet.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "Read the science"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_enzymes",
      "label": "Show Enzyme Row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_edges",
      "label": "Show Top And Bottom Rules",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F8FB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1F1F1C"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#4A5F92"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#6A80B4"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#6B6B65"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#4A5F92"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#CFD9EE"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Stage Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "stage_label_color",
      "label": "Stage Label Color",
      "default": "#6A80B4"
    },
    {
      "type": "color",
      "id": "chip_bg",
      "label": "Enzyme Chip Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "chip_text_color",
      "label": "Enzyme Chip Text Color",
      "default": "#6A80B4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Stage Label",
          "default": "Stage one"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Encapsulated"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "What happens at this stage."
        }
      ]
    },
    {
      "type": "enzyme",
      "name": "Enzyme",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Protease"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Kit Absorption",
      "category": "CWC Custom",
      "blocks": [
        { "type": "stage" },
        { "type": "stage" },
        { "type": "stage" }
      ]
    }
  ]
}
{% endschema %}
