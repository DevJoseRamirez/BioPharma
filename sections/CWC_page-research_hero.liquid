{% style %}
  #cwc_page-research-hero-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#44681A' }};
    --heading-color: {{ section.settings.heading_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#d9e7c9' }};
    --highlight-color: {{ section.settings.bold_color | default: '#ffffff' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#A3C781' }};
    --padding-top: {{ section.settings.padding_top | default: 120 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 110 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 120 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 110 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_page-research_hero.css' | asset_url | stylesheet_tag }}

<section id="cwc_page-research-hero-{{ section.id }}" class="cwc_page-research-hero">
  <div class="cwc_page-research-hero__container">
    {% comment %} Section Header {% endcomment %}
    <div class="cwc_page-research-hero__content">
      {% if section.settings.eyebrow != blank %}
        <div class="cwc_page-research-hero__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_page-research-hero__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_page-research-hero__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} Credential Badges {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_page-research-hero__badges">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'badge' %}
              {% if block.settings.label != blank %}
                <span class="cwc_page-research-hero__badge" {{ block.shopify_attributes }}>
                  {{- block.settings.label -}}
                </span>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CWC Research Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Research & Science"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>The Science Behind <strong>NanoGreens</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Most greens powders are just barley grass and a big promise. We believe you deserve more than a promise. Here is the research that backs every scoop.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#d9e7c9"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#A3C781"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 110
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Badge Text",
          "default": "Peer-Reviewed Clinical Study"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Page Research Hero",
      "category": "CWC Custom",
      "blocks": [{ "type": "badge" }, { "type": "badge" }, { "type": "badge" }]
    }
  ]
}
{% endschema %}
