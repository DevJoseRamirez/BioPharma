{% style %}
  #cwc_home-trust-strip-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#5F5B48' }};
    --highlight-color: {{ section.settings.bold_color | default: '#44681A' }};
    --label-color: {{ section.settings.label_color | default: '#44681A' }};
    --divider-color: {{ section.settings.divider_color | default: '#E0DED4' }};
    --columns-desktop: {{ section.settings.columns_desktop | default: 5 }};
    --padding-top: {{ section.settings.padding_top | default: 25 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 25 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 25 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 25 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_home_trust_strip.css' | asset_url | stylesheet_tag }}

<section
  id="cwc_home-trust-strip-{{ section.id }}"
  class="cwc_home-trust-strip{% if section.settings.show_dividers %} cwc_home-trust-strip--bordered{% endif %}{% if section.settings.hide_extra_on_mobile %} cwc_home-trust-strip--trim-mobile{% endif %}"
>
  <div class="cwc_home-trust-strip__container">
    {% if section.blocks.size > 0 %}
      <div class="cwc_home-trust-strip__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'trust_item' %}
              <div class="cwc_home-trust-strip__item" {{ block.shopify_attributes }}>
                {% if block.settings.label != blank %}
                  <span class="cwc_home-trust-strip__item-label">{{ block.settings.label }}</span>
                {% endif %}

                {% if block.settings.description != blank %}
                  <span class="cwc_home-trust-strip__item-text">{{ block.settings.description }}</span>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cwc_home-trust-strip__empty">
        <p>Add trust items to display content.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CWC Home Trust Strip",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns On Desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show Item Borders",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_extra_on_mobile",
      "label": "Show Only First 3 Items On Mobile",
      "info": "Keeps the strip to a single row on small screens.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#5F5B48"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Item Label Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Border / Divider Color",
      "default": "#E0DED4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Tested twice"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Supporting Line",
          "default": "Before and after blending"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Home Trust Strip",
      "category": "CWC Custom",
      "blocks": [
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" }
      ]
    }
  ]
}
{% endschema %}
