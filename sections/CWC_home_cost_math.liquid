{% style %}
  #cwc_home-cost-math-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#F4F3EE' }};
    --media-bg: {{ section.settings.media_bg_color | default: '#ffffff' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --total-border-color: {{ section.settings.total_border_color | default: '#2A2611' }};
    --accent-color: {{ section.settings.accent_color | default: '#5BA90F' }};
    --savings-bg: {{ section.settings.savings_bg_color | default: '#F2F8EA' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#5BA90F' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 50 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 50 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_home_cost_math.css' | asset_url | stylesheet_tag }}

<section id="cwc_home-cost-math-{{ section.id }}" class="cwc_home-cost-math">
  <div class="cwc_home-cost-math__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_home-cost-math__content">
      {% if section.settings.eyebrow != blank %}
        <div class="cwc_home-cost-math__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_home-cost-math__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_home-cost-math__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    <div class="cwc_home-cost-math__wrapper">

      {% comment %} Itemised Cost List {% endcomment %}
      <div class="cwc_home-cost-math__list">
        {% if section.settings.list_header_text != blank %}
          <div class="cwc_home-cost-math__list-head">{{ section.settings.list_header_text }}</div>
        {% endif %}

        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'cost_row' %}
              <div class="cwc_home-cost-math__row" {{ block.shopify_attributes }}>
                <div class="cwc_home-cost-math__row-info">
                  {% if block.settings.name != blank %}
                    <b class="cwc_home-cost-math__row-name">{{ block.settings.name }}</b>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <span class="cwc_home-cost-math__row-text">{{ block.settings.description }}</span>
                  {% endif %}
                </div>

                {% if block.settings.price != blank %}
                  <div class="cwc_home-cost-math__row-price">{{ block.settings.price }}</div>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}

        {% if section.settings.total_label != blank or section.settings.total_price != blank %}
          <div class="cwc_home-cost-math__row cwc_home-cost-math__row--total">
            <div class="cwc_home-cost-math__row-info">
              {% if section.settings.total_label != blank %}
                <b class="cwc_home-cost-math__row-name">{{ section.settings.total_label }}</b>
              {% endif %}
            </div>

            {% if section.settings.total_price != blank %}
              <div class="cwc_home-cost-math__row-price">
                {{ section.settings.total_price }}
                {%- if section.settings.total_suffix != blank -%}
                  <span>{{ section.settings.total_suffix }}</span>
                {%- endif -%}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% comment %} Offer Card {% endcomment %}
      <div class="cwc_home-cost-math__card">
        <div class="cwc_home-cost-math__card-image">
          {% if section.settings.card_image != blank %}
            <img
              src="{{ section.settings.card_image | image_url: width: 700 }}"
              alt="{{ section.settings.card_image_alt | default: section.settings.card_label | escape }}"
              width="700"
              height="700"
              loading="lazy"
            >
          {% else %}
            <div class="cwc_home-cost-math__placeholder">
              <span>Add product image</span>
            </div>
          {% endif %}
        </div>

        {% if section.settings.card_label != blank %}
          <div class="cwc_home-cost-math__card-label">{{ section.settings.card_label }}</div>
        {% endif %}

        {% if section.settings.card_price != blank %}
          <div class="cwc_home-cost-math__card-price">
            {{ section.settings.card_price }}
            {%- if section.settings.card_price_suffix != blank -%}
              <span>{{ section.settings.card_price_suffix }}</span>
            {%- endif -%}
          </div>
        {% endif %}

        {% if section.settings.card_sub_line != blank %}
          <div class="cwc_home-cost-math__card-sub">{{ section.settings.card_sub_line }}</div>
        {% endif %}

        {% if section.settings.savings_amount != blank or section.settings.savings_text != blank %}
          <div class="cwc_home-cost-math__card-savings">
            {%- if section.settings.savings_amount != blank -%}
              <b>{{ section.settings.savings_amount }}</b>
            {%- endif -%}
            {%- if section.settings.savings_text != blank -%}
              {{ ' ' }}{{ section.settings.savings_text }}
            {%- endif -%}
          </div>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <a class="cwc_home-cost-math__button" href="{{ section.settings.cta_link | default: '#' }}">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
      </div>

    </div>

    {% if section.settings.footnote != blank %}
      <div class="cwc_home-cost-math__footnote cwc-rte">
        {{ section.settings.footnote }}
      </div>
    {% endif %}

  </div>
</section>

