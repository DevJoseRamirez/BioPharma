{% style %}
  #cwc_how-to-use-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --deep-color: {{ section.settings.deep_color | default: '#44681A' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --step-bg: {{ section.settings.step_bg_color | default: '#5BA90F' }};
    --step-image-ratio: {{ section.settings.step_image_ratio | default: '4 / 3' }};
    --step-image-fit: {{ section.settings.step_image_fit | default: 'cover' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --tips-accent: {{ section.settings.tips_accent_color | default: '#78AD49' }};
    --padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 50 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 50 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_how_to_use.css' | asset_url | stylesheet_tag }}

<section id="cwc_how-to-use-{{ section.id }}" class="cwc_how-to-use">
  <div class="cwc_how-to-use__container">

    <div class="cwc_how-to-use__content">
      {% if section.settings.eyebrow != blank %}
        <div class="cwc_how-to-use__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_how-to-use__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_how-to-use__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% assign step_blocks = section.blocks | where: 'type', 'step' %}
    {% if step_blocks.size > 0 %}
      <div class="cwc_how-to-use__steps">
        {% for block in step_blocks %}
          <div class="cwc_how-to-use__step" {{ block.shopify_attributes }}>
            {%- comment -%}
              Optional per-step image, above the number. A card left without one
              renders exactly as it did before — the frame is only printed when
              there is an image to put in it, so no empty box appears.

              Alt falls back to the step title, since a step photo illustrates
              the thing the title already names. Both empty means the image is
              decorative and an empty alt is the correct answer.
            {%- endcomment -%}
            {% if block.settings.image != blank %}
              <div class="cwc_how-to-use__step-image">
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                  width="800"
                  height="600"
                  loading="lazy"
                >
              </div>
            {% endif %}
            <div class="cwc_how-to-use__step-number">{{ forloop.index }}</div>
            {% if block.settings.title != blank %}
              <div class="cwc_how-to-use__step-title">{{ block.settings.title }}</div>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="cwc_how-to-use__step-text cwc-rte">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% assign tip_blocks = section.blocks | where: 'type', 'tip' %}
    {% if tip_blocks.size > 0 %}
      <div class="cwc_how-to-use__tips">
        {% if section.settings.tips_heading != blank %}
          <div class="cwc_how-to-use__tips-heading">{{ section.settings.tips_heading }}</div>
        {% endif %}
        <ul class="cwc_how-to-use__tips-list">
          {% for block in tip_blocks %}
            {% if block.settings.text != blank %}
              <li class="cwc_how-to-use__tip" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "CWC How To Use",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ten seconds, every morning"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>How to <strong>use it</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>One scoop, cold water, shake. That's the whole routine.</p>"
    },
    {
      "type": "header",
      "content": "Pro Tips"
    },
    {
      "type": "text",
      "id": "tips_heading",
      "label": "Pro Tips Heading",
      "default": "Pro tips"
    },
    {
      "type": "header",
      "content": "Step Images",
      "info": "Applies to every step that has an image, so the cards stay a matched set."
    },
    {
      "type": "select",
      "id": "step_image_ratio",
      "label": "Step Image Shape",
      "options": [
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3 / 2",
          "label": "Photo (3:2)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "step_image_fit",
      "label": "Step Image Cropping",
      "options": [
        {
          "value": "cover",
          "label": "Fill the frame (crops)"
        },
        {
          "value": "contain",
          "label": "Fit inside the frame (no crop)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A2611"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted Text Color",
      "default": "#5C5842"
    },
    {
      "type": "color",
      "id": "deep_color",
      "label": "Deep Accent Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#5BA90F"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "step_bg_color",
      "label": "Step Number Background",
      "default": "#5BA90F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#E6E5DC"
    },
    {
      "type": "color",
      "id": "tips_accent_color",
      "label": "Pro Tips Accent Border",
      "default": "#78AD49"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image",
          "info": "Optional. Shown at the top of the card. Shape and cropping for every step are set under Step Images in the section settings."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Step Image Alt Text",
          "info": "Leave empty to describe the image with the step title."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Add one scoop"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>One 12g scoop into 6–16 oz of cold water. Cold matters — it mixes cleaner and tastes better.</p>"
        }
      ]
    },
    {
      "type": "tip",
      "name": "Pro Tip",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tip",
          "default": "Always use cold water — never hot"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "How To Use",
      "category": "CWC Custom",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "tip" },
        { "type": "tip" }
      ]
    }
  ]
}
{% endschema %}
