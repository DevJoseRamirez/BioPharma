{% style %}
  #cwc_home-hero-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#F4F3EE' }};
    --text-color: {{ section.settings.text_color | default: '#2A2611' }};
    --highlight-color: {{ section.settings.bold_color | default: '#5BA90F' }};
    --muted-color: {{ section.settings.muted_color | default: '#5C5842' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#5BA90F' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --border-color: {{ section.settings.border_color | default: '#E6E5DC' }};
    --accent-color: {{ section.settings.accent_color | default: '#5BA90F' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#5BA90F' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --star-color: {{ section.settings.star_color | default: '#E8A317' }};
    --media-bg: {{ section.settings.media_bg_color | default: '#ECEBE5' }};
    --media-fit: {{ section.settings.image_fit | default: 'cover' }};
    --media-min-height: {{ section.settings.media_min_height | default: 540 }}px;
    --pill-bg: {{ section.settings.pill_bg_color | default: '#ffffff' }};
    --stat-color: {{ section.settings.stat_color | default: '#44681A' }};
    --padding-top: {{ section.settings.padding_top | default: 90 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 90 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 90 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_home_hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  HEADLINE TEST VARIANTS — paste into the "Headline" setting to swap:
  B · Mechanism: <p>Ten servings of produce. <strong>Nine enzymes that get them in.</strong></p>
  C · Problem:   <p>Most of a greens powder <strong>passes right through you.</strong></p>
  D · Habit:     <p>The greens powder <strong>people actually finish.</strong></p>
{%- endcomment -%}

{%- liquid
  assign stat_count = 0
  for block in section.blocks
    if block.type == 'stat'
      assign stat_count = stat_count | plus: 1
    endif
  endfor

  assign offer_pos_class = 'cwc_home-hero__offer--above'
  if section.settings.offer_position == 'below_cta'
    assign offer_pos_class = 'cwc_home-hero__offer--below'
  endif

  assign rating_pos_class = 'cwc_home-hero__rating--below'
  if section.settings.rating_position == 'above_cta'
    assign rating_pos_class = 'cwc_home-hero__rating--above'
  endif
-%}

{%- comment -%} Offer callout — card or inline line, placed either side of the CTA row {%- endcomment -%}
{%- capture offer_html -%}
  {%- if section.settings.show_offer -%}
    {%- if section.settings.offer_price_text != blank
      or section.settings.offer_save_badge != blank
      or section.settings.offer_per_serving != blank
      or section.settings.offer_fine_print != blank
    -%}
      {%- if section.settings.offer_style == 'inline' -%}
        {%- liquid
          assign offer_bits = ''
          if section.settings.offer_price_text != blank
            assign offer_bits = offer_bits | append: section.settings.offer_price_text | append: '||'
          endif
          if section.settings.offer_save_badge != blank
            assign offer_bits = offer_bits | append: section.settings.offer_save_badge | append: '||'
          endif
          if section.settings.offer_per_serving != blank
            assign offer_bits = offer_bits | append: section.settings.offer_per_serving | append: '||'
          endif
          if section.settings.offer_fine_print != blank
            assign offer_bits = offer_bits | append: section.settings.offer_fine_print | append: '||'
          endif
          assign offer_list = offer_bits | split: '||'
        -%}
        <div class="cwc_home-hero__offer cwc_home-hero__offer--inline {{ offer_pos_class }}">
          {{ offer_list | join: ' · ' }}
        </div>
      {%- else -%}
        <div class="cwc_home-hero__offer {{ offer_pos_class }}">
          <div class="cwc_home-hero__offer-top">
            {%- if section.settings.offer_price_text != blank -%}
              <span class="cwc_home-hero__offer-price">{{ section.settings.offer_price_text }}</span>
            {%- endif -%}

            {%- if section.settings.offer_save_badge != blank -%}
              <span class="cwc_home-hero__offer-badge">{{ section.settings.offer_save_badge }}</span>
            {%- endif -%}

            {%- if section.settings.offer_per_serving != blank -%}
              <span class="cwc_home-hero__offer-serving">{{ section.settings.offer_per_serving }}</span>
            {%- endif -%}
          </div>

          {%- if section.settings.offer_fine_print != blank -%}
            <div class="cwc_home-hero__offer-note">{{ section.settings.offer_fine_print }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- comment -%} Rating line — placed either side of the CTA row {%- endcomment -%}
{%- capture rating_html -%}
  {%- if section.settings.show_rating -%}
    {%- assign rating_rounded = section.settings.rating_value | round -%}
    <div class="cwc_home-hero__rating {{ rating_pos_class }}">
      <span class="cwc_home-hero__stars" aria-hidden="true">
        {%- for i in (1..5) -%}
          {%- if i <= rating_rounded -%}★{%- else -%}☆{%- endif -%}
        {%- endfor -%}
      </span>

      <span class="cwc_home-hero__rating-value">{{ section.settings.rating_value }}</span>

      {%- if section.settings.rating_count != blank or section.settings.rating_extra_text != blank -%}
        <span class="cwc_home-hero__rating-text">
          {%- if section.settings.rating_count != blank -%}
            {{ section.settings.rating_count }}
          {%- endif -%}
          {%- if section.settings.rating_count != blank and section.settings.rating_extra_text != blank -%}
            {{ ' · ' }}
          {%- endif -%}
          {%- if section.settings.rating_extra_text != blank -%}
            {{ section.settings.rating_extra_text }}
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<section
  id="cwc_home-hero-{{ section.id }}"
  class="cwc_home-hero{% if section.settings.image_position == 'left' %} cwc_home-hero--reverse{% endif %}"
>
  <div class="cwc_home-hero__container">
    <div class="cwc_home-hero__wrapper">

      {% comment %} Text column {% endcomment %}
      <div class="cwc_home-hero__content">
        {% if section.settings.eyebrow != blank %}
          {% if section.settings.eyebrow_style == 'pill' %}
            <div class="cwc_home-hero__eyebrow cwc_home-hero__eyebrow--pill">
              <span class="cwc_home-hero__eyebrow-label">{{ section.settings.eyebrow }}</span>

              {% if section.settings.eyebrow_detail != blank %}
                <span class="cwc_home-hero__eyebrow-detail">{{ section.settings.eyebrow_detail }}</span>
              {% endif %}
            </div>
          {% else %}
            <div class="cwc_home-hero__eyebrow">{{ section.settings.eyebrow }}</div>
          {% endif %}
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_home-hero__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.lede != blank %}
          <div class="cwc_home-hero__lede cwc-rte">
            {{ section.settings.lede }}
          </div>
        {% endif %}

        {% if section.settings.rating_position == 'above_cta' %}
          {{ rating_html }}
        {% endif %}

        {% if section.settings.offer_position != 'below_cta' %}
          {{ offer_html }}
        {% endif %}

        {% if section.settings.cta_label != blank or section.settings.secondary_label != blank %}
          <div class="cwc_home-hero__cta">
            {% if section.settings.cta_label != blank %}
              <a
                class="cwc_home-hero__button"
                href="{{ section.settings.cta_link | default: '#' }}"
              >
                {{ section.settings.cta_label }}
              </a>
            {% endif %}

            {% if section.settings.secondary_label != blank %}
              <a
                class="cwc_home-hero__link"
                href="{{ section.settings.secondary_link | default: '#' }}"
              >
                {{ section.settings.secondary_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.offer_position == 'below_cta' %}
          {{ offer_html }}
        {% endif %}

        {% if section.settings.rating_position != 'above_cta' %}
          {{ rating_html }}
        {% endif %}

        {% if section.settings.show_stats and stat_count > 0 %}
          <div class="cwc_home-hero__stats">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'stat' %}
                  <div class="cwc_home-hero__stat" {{ block.shopify_attributes }}>
                    {% if block.settings.value != blank %}
                      <div class="cwc_home-hero__stat-value">{{ block.settings.value }}</div>
                    {% endif %}

                    {% if block.settings.label != blank %}
                      <div class="cwc_home-hero__stat-label">{{ block.settings.label }}</div>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% comment %} Media column {% endcomment %}
      <div class="cwc_home-hero__media">
        {% if section.settings.hero_image != blank %}
          <img
            src="{{ section.settings.hero_image | image_url: width: 1400 }}"
            alt="{{ section.settings.image_alt | default: 'Product image' | escape }}"
            width="1400"
            height="1200"
            loading="eager"
            fetchpriority="high"
          >
        {% else %}
          <div class="cwc_home-hero__placeholder">
            <span>Add hero image</span>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

