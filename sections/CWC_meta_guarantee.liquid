{% style %}
  #cwc_meta_guarantee-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#44681A' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --highlight-color: {{ section.settings.bold_color | default: '#DCEFC4' }};
    --seal-color: {{ section.settings.seal_color | default: '#DCEFC4' }};
    --seal-border-color: {{ section.settings.seal_border_color | default: '#8FAE68' }};
    --mark-color: {{ section.settings.mark_color | default: '#E6EFDA' }};
    --padding-top: {{ section.settings.padding_top | default: 70 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 70 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 70 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_fonts.css' | asset_url | stylesheet_tag }}
{{ 'CWC_meta_guarantee.css' | asset_url | stylesheet_tag }}

<section id="cwc_meta_guarantee-{{ section.id }}" class="cwc_meta_guarantee">
  <div class="cwc_meta_guarantee__container">

    {% if section.settings.show_seal and section.settings.seal_number != blank %}
      <div class="cwc_meta_guarantee__seal">
        <span class="cwc_meta_guarantee__seal-number">{{ section.settings.seal_number }}</span>
        {% if section.settings.seal_unit_label != blank %}
          <span class="cwc_meta_guarantee__seal-unit">{{ section.settings.seal_unit_label }}</span>
        {% endif %}
      </div>
    {% endif %}

    <div class="cwc_meta_guarantee__content">
      {% if section.settings.heading != blank %}
        <div class="cwc_meta_guarantee__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="cwc_meta_guarantee__content-subtext cwc-rte">
          {{ section.settings.body }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="cwc_meta_guarantee__marks">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'mark' %}
              {% if block.settings.text != blank %}
                <span class="cwc_meta_guarantee__mark" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </span>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Meta Guarantee",
  "settings": [
    {
      "type": "header",
      "content": "Seal"
    },
    {
      "type": "checkbox",
      "id": "show_seal",
      "label": "Show Seal",
      "default": true
    },
    {
      "type": "text",
      "id": "seal_number",
      "label": "Seal Number",
      "default": "30"
    },
    {
      "type": "text",
      "id": "seal_unit_label",
      "label": "Seal Unit Label",
      "default": "DAY"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Love it, or get <strong>your money back</strong></p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Try it for thirty days. If it isn't for you, contact us for a full refund — opened tub and all.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#44681A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#DCEFC4"
    },
    {
      "type": "color",
      "id": "seal_color",
      "label": "Seal Text Color",
      "default": "#DCEFC4"
    },
    {
      "type": "color",
      "id": "seal_border_color",
      "label": "Seal Border Color",
      "default": "#8FAE68"
    },
    {
      "type": "color",
      "id": "mark_color",
      "label": "Mark Text Color",
      "default": "#E6EFDA"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "mark",
      "name": "Mark",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "30-day money-back guarantee"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Meta Guarantee",
      "category": "CWC Custom",
      "blocks": [
        { "type": "mark" },
        { "type": "mark" },
        { "type": "mark" },
        { "type": "mark" }
      ]
    }
  ]
}
{% endschema %}
