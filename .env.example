# Firecrawl API key — needed only for the /crawl capture command.
#
# RECOMMENDED: set this once at your machine level instead of per-project.
#   Add to ~/.bashrc (or ~/.zshrc):
#     export FIRECRAWL_API_KEY=fc-your-key-here
#   Every project's .mcp.json reads it from the environment automatically.
#
# ALTERNATIVE (per-project): copy this file to .env and fill in your key.
#   .env is gitignored — NEVER commit a real key.
#
# Get a key: https://firecrawl.dev

FIRECRAWL_API_KEY=fc-your-key-here
